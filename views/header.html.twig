{#
 # Header
 #
 # @package AgenceCinq
 #}

<header
	role="banner"
	class="{{
		html_classes(
			'border-default bg-default border-b py-[0.78125rem] text-sm lg:py-0',
			classes | default( [] ) | join( ' ' )
		)
	}}"
>
	<div class="container flex items-center gap-4 lg:gap-6">
		<div class="flex-1 lg:me-auto">
			<a href="{{ site.link }}" class="block h-[1.190625rem] w-16" aria-label="{{ site.name }}">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'logo',
							classes: [ 'size-full' ],
						}
					)
				-}}
				<span class="sr-only">{{- site.name -}}</span>
			</a>
		</div>

		{%- if nav_menus.main.get_items -%}
			<nav aria-label="{{ __( 'Main navigation', 'agencecinq' ) }}" class="hidden flex-1 lg:block">
				<ul class="flex">
					{% for item in nav_menus.main.get_items() %}
						<li
							class="group relative"
							itemscope
							itemtype="https://schema.org/SiteNavigationElement"
						>
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="{{
									html_classes(
										'px-4 pt-[1.40625rem] pb-[1.34375rem]',
										item.current
											or 'current-menu-parent' in item.classes
											or 'current-page-ancestor' in item.classes
											? 'text-accent-default'
											: '',
										item.classes | default( [] ) | join( ' ' ),
										'hover:text-accent-default group-hover:text-accent-default text-muted focus:text-accent-default group-focus-within:text-accent-default block'
									)
								}}"
								{{ item.children | length ? 'aria-haspopup="true"' }}
								{{ item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"' }}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>

							{%- if item.children | length -%}
								<ul
									class="border-subtle bg-surface invisible absolute inset-s-0 top-full z-20 w-72 space-y-6 rounded-b-md border px-5 py-4.5 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
								>
									{% for child in item.children %}
										<li itemscope itemtype="https://schema.org/SiteNavigationElement">
											<a
												href="{{ child.url }}"
												itemprop="url"
												class="text-primary hover:text-accent-default focus:text-accent-default font-sans text-base transition-colors"
												{{ child.is_target_blank or child.is_external
													? 'target="' ~ child.target ~ '" rel="noopener noreferrer"' }}
											>
												<span itemprop="name">{{- child.title -}}</span>
											</a>
										</li>
									{% endfor %}
								</ul>
							{%- endif -%}
						</li>
					{% endfor %}
				</ul>
			</nav>
		{%- endif -%}

		<div class="flex flex-1 justify-end lg:ms-auto">
			{{-
				include(
					'components/button.html.twig',
					theme.contact.link | default( {} ) | merge( { variant: 'tertiary' } ),
					with_context: false
				)
			-}}
		</div>

		<cinq-drawer-button class="block lg:hidden">
			{% set icon_html %}
				{{-
					include(
						'svg/use.html.twig',
						{
							classes: [ 'size-5', 'block group-aria-expanded/drawer-button:hidden' ],
							icon: 'menu',
						}
					)
				-}}
				{{-
					include(
						'svg/use.html.twig',
						{
							classes: [ 'size-5', 'hidden group-aria-expanded/drawer-button:block' ],
							icon: 'close',
						}
					)
				-}}
			{% endset %}
			{{-
				include(
					'components/button.html.twig',
					{
						icon_html: icon_html,
						attributes: { 'aria-controls': 'menu-drawer' },
						title: '<span class="sr-only">' ~ __( 'Menu', 'agencecinq' ) ~ '</span>',
						classes: [ 'group/drawer-button' ],
						variant: 'quaternary',
					},
					with_context: false
				)
			-}}
		</cinq-drawer-button>
	</div>
</header>

{% embed 'components/drawer.html.twig'
	with {
		id: 'menu-drawer',
		classes: [],
		aria_label: __( 'Menu', 'agencecinq' ),
	}
%}
	{% block content %}
		<cinq-mobile-menu class="relative block h-full">
			{{-
				include(
					'components/mobile-menu.html.twig',
					{ items: nav_menus.main is defined ? nav_menus.main.get_items() | default( [] ) : [] }
				)
			-}}
		</cinq-mobile-menu>
	{% endblock %}
{% endembed %}
