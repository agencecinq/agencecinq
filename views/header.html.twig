{#
 # Header
 #
 # @package AgenceCinq
 #}

<header
	role="banner"
	class="{{
	html_classes(
		'text-label text-cream border-cream/11 border-b bg-black py-[0.78125rem]',
		classes | default([]) | join(' ')
	)
	}}"
>
	<div class="container flex items-center gap-4 lg:gap-6">
		<div class="flex-1 lg:me-auto">
			<a href="{{ site.link }}" class="block h-[1.190625rem] w-16" aria-label="{{ site.name }}">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'logo',
							classes: ['size-full']
						}
					)
				-}}
				<span class="sr-only">{{- site.name -}}</span>
			</a>
		</div>

		{%- if nav_menus.main.get_items -%}
			<nav aria-label="{{ __('Main navigation', 'agencecinq') }}" class="hidden flex-1 lg:block">
				<ul itemscope class="flex gap-8" itemtype="http://schema.org/SiteNavigationElement">
					{% for item in nav_menus.main.get_items() %}
						<li class="group">
							<a
								href="{{ item.url }}"
								itemprop="url"
								class="{{
								html_classes(
									item.current
										or 'current-menu-parent' in item.classes
										or 'current-page-ancestor' in item.classes
										? 'text-pistachio'
										: '',
									item.classes | default([]) | join(' '),
									'hover:text-pistachio text-cream/65 block'
								)
								}}"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferer"'
								}}
							>
								{{- item.title -}}
							</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		{%- endif -%}

		<div class="flex flex-1 justify-end lg:ms-auto">
			{{-
				include(
					'components/button.html.twig',
					theme.contact.link
						| default({})
						| merge({
							variant: 'tertiary'
						}),
					with_context = false
				)
			-}}
		</div>

		<cinq-drawer-button class="block lg:hidden">
			{% set icon_html %}
				{{-
					include(
						'svg/use.html.twig',
						{
							classes: ['size-5', 'block group-aria-expanded/drawer-button:hidden'],
							icon: 'bars'
						}
					)
				-}}
				{{-
					include(
						'svg/use.html.twig',
						{
							classes: ['size-5', 'hidden group-aria-expanded/drawer-button:block'],
							icon: 'times'
						}
					)
				-}}
			{% endset %}
			{{-
				include(
					'components/button.html.twig',
					{
						icon_html: icon_html,
						attributes: {
							'aria-controls': 'menu-drawer'
						},
						title: '<span class="sr-only">' ~ __('Menu', 'agencecinq') ~ '</span>',
						classes: ['group/drawer-button'],
						variant: 'quaternary'
					},
					with_context = false
				)
			-}}
		</cinq-drawer-button>
	</div>
</header>

{% embed 'components/drawer.html.twig'
	with {
		id: 'menu-drawer',
		classes: [],
		aria_label: __('Menu', 'agencecinq')
	}
%}
	{% block content %}
		<cinq-mobile-menu class="text-cream relative mx-auto block h-full max-w-182 p-5">
			{{-
				include(
					'components/mobile-menu.html.twig',
					{
						items: nav_menus.main is defined ? nav_menus.main.get_items() | default([]) : []
					}
				)
			-}}
		</cinq-mobile-menu>
	{% endblock %}
{% endembed %}
