{#
 # Header
 #
 # Figma Section/Header: the logo, the main navigation, a secondary and a primary action. A Nav link with
 # children is a button that opens its Submenu: <cinq-disclosure-navigation> keeps one open at a time,
 # opens it on hover too, and closes it with Escape or when the focus leaves it. Below xl, where the whole
 # navigation does not fit, the menu button opens the drawer.
 #
 # @package AgenceCinq
 #}

{%- set items = nav_menus.main is defined ? nav_menus.main.get_items() | default( [] ) : [] -%}
{%- set secondary = nav_menus.secondary is defined
	? nav_menus.secondary.get_items() | default( [] )
	: []
-%}

<header
	role="banner"
	class="{{
		html_classes( 'border-default bg-default border-b', classes | default( [] ) | join( ' ' ) )
	}}"
>
	<div class="container flex items-center justify-between gap-6 py-3 xl:py-4">
		<a
			href="{{ site.link }}"
			class="focus-visible:outline-focus-ring block h-6 w-20 shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2"
			aria-label="{{ __( 'CINQ, home', 'agencecinq' ) }}"
		>
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'logo',
						classes: [ 'size-full' ],
						attributes: { 'aria-hidden': 'true' },
					},
					with_context: false
				)
			-}}
		</a>

		{%- if items | length -%}
			<cinq-disclosure-navigation class="hidden xl:block" data-hover>
				<nav aria-label="{{ __( 'Main navigation', 'agencecinq' ) }}">
					<ul class="flex items-center gap-6">
						{%- for item in items -%}
							<li class="relative">
								{%- if item.children | length -%}
									{{-
										include(
											'components/nav-link.html.twig',
											{
												title: item.title,
												controls: 'submenu-' ~ item.id,
												current: item.current or item.current_item_ancestor,
											},
											with_context: false
										)
									-}}
									{{-
										include(
											'components/submenu.html.twig',
											{
												id: 'submenu-' ~ item.id,
												items: item.children,
											},
											with_context: false
										)
									-}}
								{%- else -%}
									{{-
										include(
											'components/nav-link.html.twig',
											{
												title: item.title,
												url: item.url,
												current: item.current,
											},
											with_context: false
										)
									-}}
								{%- endif -%}
							</li>
						{%- endfor -%}
					</ul>
				</nav>
			</cinq-disclosure-navigation>
		{%- endif -%}

		<div class="flex items-center gap-3">
			{%- for item in secondary -%}
				{{-
					include(
						'components/button.html.twig',
						{
							title: item.title,
							url: item.url,
							target: item.is_target_blank ? '_blank',
							variant: 'secondary',
							arrow: false,
							classes: [ 'max-xl:hidden' ],
						},
						with_context: false
					)
				-}}
			{%- endfor -%}
			{%- if theme.contact.link | default( false ) -%}
				{{-
					include(
						'components/button.html.twig',
						theme.contact.link | merge( { arrow: false } ),
						with_context: false
					)
				-}}
			{%- endif -%}

			<cinq-drawer-button class="block xl:hidden">
				{{-
					include(
						'components/icon-button.html.twig',
						{
							label: __( 'Open the menu', 'agencecinq' ),
							icon: 'menu',
							attributes: {
								'aria-controls': 'menu-drawer',
								'aria-expanded': 'false',
							},
						},
						with_context: false
					)
				-}}
			</cinq-drawer-button>
		</div>
	</div>
</header>

{% embed 'components/drawer.html.twig'
	with {
		id: 'menu-drawer',
		aria_label: __( 'Menu', 'agencecinq' ),
		items: items,
		secondary: secondary,
		theme: theme,
	} only
%}
	{% block content %}
		{{-
			include(
				'components/mobile-menu.html.twig',
				{
					items: items,
					secondary: secondary,
					contact: theme.contact | default( {} ),
				},
				with_context: false
			)
		-}}
	{% endblock %}
{% endembed %}
