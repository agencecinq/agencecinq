{#
 # Footer
 #
 # @package WordPress
 # @subpackage CollectiveLaCabane/views
 #
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

<footer
	role="contentinfo"
	class="text-subtle bg-elevated border-border border-t pt-18 pb-8 lg:pt-31 lg:pb-8.5"
>
	<div class="container space-y-15 lg:space-y-11.75">
		{%- if nav_menus.footer.get_items -%}
			<nav aria-label="{{ __('Footer', 'agencecinq') }}">
				<ul class="grid gap-6 lg:grid-cols-4 lg:gap-5">
					{%- for item in nav_menus.footer.get_items() -%}
						<li itemscope itemtype="https://schema.org/SiteNavigationElement" class="lg:col-span-1">
							{%- if item.children -%}
								<div class="space-y-5">
									<span class="text-xl" itemprop="name">{{- item.title -}}</span>
									<ul class="space-y-3">
										{%- for child in item.children -%}
											<li itemscope itemtype="https://schema.org/SiteNavigationElement">
												<a
													href="{{ child.url }}"
													itemprop="url"
													class="text-badge hover:underline"
													{{
													child.is_target_blank or child.is_external
														? 'target="' ~ child.target ~ '" rel="noopener noreferrer"'
													}}
												>
													<span itemprop="name">{{- child.title -}}</span>
												</a>
											</li>
										{%- endfor -%}
									</ul>
								</div>
							{%- else -%}
								<a
									href="{{ item.url }}"
									itemprop="url"
									class="text-xl"
									{{
									item.is_target_blank or item.is_external
										? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
									}}
								>
									<span itemprop="name">{{- item.title -}}</span>
								</a>
							{%- endif -%}
						</li>
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}

		<div
			class="border-border text-label flex flex-col gap-3 border-t pt-6 lg:flex-row lg:justify-between"
		>
			<div class="flex items-center gap-2">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: ['w-2.5 h-[0.35rem]']
						}
					)
				-}}

				{{- '&copy;&nbsp;' ~ ('now' | date('Y')) ~ '&nbsp;' ~ site.name ~ '&nbsp;&middot;&nbsp;' -}}
				{{- __('Made with care', 'wp-agencecinq') -}}
			</div>
			{%- if nav_menus.legals.get_items -%}
				<ul itemscope class="flex gap-5" itemtype="http://schema.org/SiteNavigationElement">
					{%- for item in nav_menus.legals.get_items() -%}
						<li>
							<a
								href="{{ item.url }}"
								class="hover:underline"
								itemprop="url"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferer"'
								}}
							>
								{{- item.title -}}
							</a>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</div>
</footer>
