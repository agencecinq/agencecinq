{#
 # Footer
 #
 # Figma Section/Footer: the logo and its line, then one column per item of the footer menu that has
 # children, and a Contact column from the theme options, on the layout grid. Below, the copyright and
 # the legal menu, whose sitemap link is the second navigation system (RGAA 12.1), and whose item linked to
 # #cookies is a button that opens the cookie choices. Links underline on hover and focus.
 #
 # @package AgenceCinq
 #}

{%- set contact = theme.contact | default( {} ) -%}
{%- set locations = contact.locations | default( [] ) | filter( location => location.title ) -%}
{%- set columns = nav_menus.footer is defined
	? nav_menus.footer.get_items() | filter( item => item.children | length )
	: []
-%}
{%- set legals = nav_menus.legals is defined ? nav_menus.legals.get_items() | default( [] ) : [] -%}
{%- set link =
	'text-primary focus-visible:outline-focus-ring hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2'
-%}

<footer role="contentinfo" class="border-default bg-default border-t pt-14 pb-8 lg:pt-20">
	<div class="container flex flex-col gap-10 lg:gap-14">
		<div class="layout-grid gap-y-10">
			<div class="col-span-full flex flex-col items-start gap-4 lg:col-span-4">
				<a
					href="{{ site.link }}"
					class="focus-visible:outline-focus-ring block h-6 w-20 focus-visible:outline-2 focus-visible:outline-offset-2"
					aria-label="{{ __( 'CINQ, home', 'agencecinq' ) }}"
				>
					{{-
						include(
							'svg/use.html.twig',
							{
								icon: 'logo',
								classes: [ 'size-full' ],
								attributes: { 'aria-hidden': 'true' },
							},
							with_context: false
						)
					-}}
				</a>
				{%- if theme.footer.text | default( false ) -%}
					<p class="text-body text-lg">{{- theme.footer.text -}}</p>
				{%- endif -%}
			</div>

			<nav
				class="col-span-full grid grid-cols-subgrid gap-y-8 lg:col-span-8"
				aria-label="{{ __( 'Footer navigation', 'agencecinq' ) }}"
			>
				{%- for column in columns -%}
					<div class="col-span-2 flex flex-col gap-3">
						<p id="footer-{{ column.id }}" class="text-eyebrow text-muted">{{- column.title -}}</p>
						<ul class="flex flex-col gap-3 text-sm" aria-labelledby="footer-{{ column.id }}">
							{%- for item in column.children -%}
								<li>
									<a
										class="{{ link }}"
										{{
											html_attr(
												{ href: item.url },
												item.is_target_blank
													? {
														target: '_blank',
														rel: 'noopener noreferrer',
													}
											)
										}}
									>
										{{- item.title -}}
									</a>
								</li>
							{%- endfor -%}
						</ul>
					</div>
				{%- endfor -%}

				{%- if contact.phone or contact.email or ( locations | length ) or contact.link -%}
					<div class="col-span-2 flex flex-col gap-3">
						<p id="footer-contact" class="text-eyebrow text-muted">
							{{- __( 'Contact', 'agencecinq' ) -}}
						</p>
						<ul class="flex flex-col gap-3 text-sm" aria-labelledby="footer-contact">
							{%- if contact.phone -%}
								<li>
									<a class="{{ link }}" href="tel:{{ contact.phone | tel }}">
										{{- contact.phone -}}
									</a>
								</li>
							{%- endif -%}
							{%- if contact.email -%}
								<li>
									<a class="{{ link }}" href="mailto:{{ contact.email }}">{{- contact.email -}}</a>
								</li>
							{%- endif -%}
							{%- for location in locations -%}
								<li class="text-primary">{{- location.title -}}</li>
							{%- endfor -%}
							{%- if contact.link.url | default( false ) -%}
								<li>
									<a
										class="{{ link }}"
										{{
											html_attr(
												{ href: contact.link.url },
												contact.link.target == '_blank'
													? {
														target: '_blank',
														rel: 'noopener noreferrer',
													}
											)
										}}
									>
										{{- contact.link.title -}}
									</a>
								</li>
							{%- endif -%}
						</ul>
					</div>
				{%- endif -%}
			</nav>
		</div>

		<div
			class="border-default text-muted flex flex-col gap-3 border-t pt-6 text-sm lg:flex-row lg:justify-between"
		>
			<p>
				{{- '© ' ~ ( 'now' | date( 'Y' ) ) ~ ' '
					~ ( theme.footer.copyright | default( site.name ) ) -}}
			</p>
			{%- if legals | length -%}
				<ul
					class="flex flex-wrap gap-x-2 gap-y-1"
					aria-label="{{ __( 'Legal information', 'agencecinq' ) }}"
				>
					{%- for item in legals -%}
						<li class="flex gap-2">
							{%- if not loop.first -%}
								<span aria-hidden="true">·</span>
							{%- endif -%}
							{%- if item.url ends with '#cookies' -%}
								<button
									type="button"
									class="focus-visible:outline-focus-ring cursor-pointer hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
									commandfor="cookie-preferences"
									command="show-modal"
								>
									{{- item.title -}}
								</button>
							{%- else -%}
								<a
									class="focus-visible:outline-focus-ring hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-offset-2"
									href="{{ item.url }}"
								>
									{{- item.title -}}
								</a>
							{%- endif -%}
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</div>
</footer>
