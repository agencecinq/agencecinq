{#
 # Footer
 #
 # @package WordPress
 # @subpackage AgenceCinq/views
 #
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

<footer
	role="contentinfo"
	class="text-stone text-label bg-dark-gray border-cream-soft border-t pt-18 pb-8 lg:pt-31 lg:pb-8.5"
>
	<div class="container space-y-12 lg:space-y-20">
		<div class="layout-grid gap-y-10">
			<div class="col-span-full space-y-4 lg:col-span-4">
				<a href="{{ site.url }}" class="text-cream block h-[1.339375rem] w-18">
					{{
						include(
							'svg/use.html.twig',
							{
								icon: 'logo',
								classes: ['size-full']
							}
						)
					}}
				</a>

				<p class="text-taupe text-sm">
					Un site est un actif. Pas un passif qu’on change tous les trois ans.
				</p>

				<div class="space-y-1">
					<p>
						Paris · Tours · Marseille
					</p>
					<p class="text-pistachio">
						<a href="mailto:contact@agencecinq.com">contact@agencecinq.com</a>
					</p>
					<p class="text-pistachio">
						<a href="tel:0673778608">06 73 77 86 08</a>, Joachim, fondateur
					</p>
				</div>
			</div>
			{%- if nav_menus.footer.get_items() -%}
				<nav
					class="col-span-full lg:col-span-8"
					aria-label="{{ __('Footer navigation', 'agencecinq') }}"
				>
					<ul class="grid grid-cols-4 gap-4 lg:gap-6">
						{%- for item in nav_menus.footer.get_items() -%}
							<li
								itemscope
								itemtype="https://schema.org/SiteNavigationElement"
								class="col-span-2 space-y-3 lg:col-span-1"
							>
								{%- if item.children -%}
									<p class="text-eyebrow" itemprop="name">
										{{- item.title -}}
									</p>
									<ul class="space-y-3">
										{%- for child in item.children -%}
											<li itemscope itemtype="https://schema.org/SiteNavigationElement">
												<a
													href="{{ child.url }}"
													itemprop="url"
													class="text-taupe text-sm hover:underline"
													{{
													child.is_target_blank or child.is_external
														? 'target="' ~ child.target ~ '" rel="noopener noreferrer"'
													}}
												>
													<span itemprop="name">{{- child.title -}}</span>
												</a>
											</li>
										{%- endfor -%}
									</ul>
								{%- else -%}
									<a
										href="{{ item.url }}"
										itemprop="url"
										class=""
										{{
										item.is_target_blank or item.is_external
											? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
										}}
									>
										<span itemprop="name">{{- item.title -}}</span>
									</a>
								{%- endif -%}
							</li>
						{%- endfor -%}
					</ul>
				</nav>
			{%- endif -%}
		</div>

		<div class="border-cream-soft flex flex-col gap-3 border-t pt-6 lg:flex-row lg:justify-between">
			<div class="flex items-center gap-2">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: ['w-2.5 h-[0.35rem]']
						}
					)
				-}}

				{{- '&copy;&nbsp;' ~ ('now' | date('Y')) ~ '&nbsp;' ~ site.name ~ '&nbsp;&middot;&nbsp;' -}}
				{{- __('Made with care', 'agencecinq') -}}
			</div>
			{%- if nav_menus.legals.get_items -%}
				<ul itemscope class="flex gap-5" itemtype="http://schema.org/SiteNavigationElement">
					{%- for item in nav_menus.legals.get_items() -%}
						<li>
							<a
								href="{{ item.url }}"
								class="hover:underline"
								itemprop="url"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferer"'
								}}
							>
								{{- item.title -}}
							</a>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</div>
</footer>
