{#
 # 404
 #
 # Figma T20 · Not found, Section/Status message over the snake: the title in H1, the text, the link to the
 # sitemap and the one back to the home page on seven columns, then on the last four the diff of the address
 # that no longer exists, decorative since the text says it. The snake plays behind, with a keyboard, its
 # canvas hidden on touch screens.
 #
 # @package WordPress
 # @subpackage AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main">
		<section class="relative transform-3d" aria-labelledby="error-title">
			<cinq-snake cols="39" rows="15" class="relative block">
				<canvas
					tabindex="0"
					class="text-accent-soft absolute inset-0 z-1 block size-full touch-none outline-none pointer-coarse:hidden"
					aria-label="{{ __( 'Snake. Arrow keys to move.', 'agencecinq' ) }}"
				></canvas>
				<div
					class="text-eyebrow text-accent-default pointer-events-none absolute inset-x-0 top-6 z-5 container flex items-center gap-2 pointer-coarse:hidden"
				>
					<p class="flex items-center gap-2">
						{{- __( 'Score', 'agencecinq' ) -}}
						<span data-score aria-live="polite">0</span>
					</p>
					<button
						type="button"
						hidden
						data-replay
						class="hover:text-accent-hover focus-visible:text-accent-hover pointer-events-auto transition-colors hover:underline focus-visible:underline"
					>
						{{- __( 'Replay', 'agencecinq' ) -}}
					</button>
				</div>
				<div
					class="layout-grid pointer-events-none relative z-2 container items-start gap-y-10 py-20 lg:py-34"
				>
					<div class="col-span-full flex flex-col items-start gap-5 lg:col-span-7">
						<h1 id="error-title" class="text-title-xxl text-primary">{{- post.title -}}</h1>
						{%- if post.text -%}
							<p class="text-body text-lg">{{- post.text -}}</p>
						{%- endif -%}
						<div class="flex flex-wrap items-center gap-4">
							{%- if post.link.url -%}
								{{-
									include(
										'components/button.html.twig',
										post.link | merge( {
											variant: 'primary',
											classes: [ 'pointer-events-auto' ],
										} ),
										with_context: false
									)
								-}}
							{%- endif -%}
							{{-
								include(
									'components/button.html.twig',
									{
										title: __( 'Back to home', 'agencecinq' ),
										url: home_url,
										variant: 'text',
										arrow: false,
										classes: [ 'pointer-events-auto' ],
									},
									with_context: false
								)
							-}}
						</div>
					</div>
					<div class="col-span-full lg:col-span-4 lg:col-start-9" aria-hidden="true">
						{{-
							include(
								'components/diff-block.html.twig',
								{
									address: post.host,
									note: __( 'error 404', 'agencecinq' ),
									removed: [ post.removed ],
									added: post.added ? [ post.added ] : [],
								},
								with_context: false
							)
						-}}
					</div>
				</div>
			</cinq-snake>
		</section>
	</main>
{%- endblock -%}
