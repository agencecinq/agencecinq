{#
 # Single post
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	{%- set category =
		post.categories
			| default([])
			| filter(term => term.slug not in ['uncategorized', 'non-classe'])
			| first
	-%}
	{%- set excerpt = post.post_excerpt | default('') | trim -%}
	{%- if not excerpt -%}
		{%- set excerpt =
			post.excerpt({
				words: 40,
				read_more: false
			}) | striptags | trim
		-%}
	{%- endif -%}

	<main id="content" role="main" itemscope itemtype="https://schema.org/BlogPosting">
	

		<section class="pb-20 pt-18 lg:pb-20 lg:pt-26" aria-labelledby="post-title">
			<div class="layout-grid container items-center gap-y-10 lg:gap-x-20">
				<div class="col-span-full space-y-8 lg:col-span-6">
					<header class="space-y-6">
						<p class="text-label text-taupe uppercase">
							<time datetime="{{ post.date('c') }}" itemprop="datePublished">
								{{- post.date('j F Y') | upper -}}
							</time>
							{%- if category -%}
								<span aria-hidden="true"> · </span>
								<span itemprop="articleSection">{{- category.name | upper -}}</span>
							{%- endif -%}
							{%- if post.reading_time -%}
								<span aria-hidden="true"> · </span>
								<span>
									{{- __('%s min de lecture', 'agencecinq') | format(post.reading_time) -}}
								</span>
							{%- endif -%}
						</p>

						<h1 id="post-title" class="text-title-xl text-cream" itemprop="headline">
							{{- post.title -}}
						</h1>
					</header>

					{%- if excerpt -%}
						<p class="text-taupe text-xl" itemprop="description">
							{{- excerpt -}}
						</p>
					{%- endif -%}

					{%- if post.author.name -%}
						<p class="text-label text-stone uppercase" itemprop="author" itemscope itemtype="https://schema.org/Person">
							{{- __('Par %s', 'agencecinq') | format(post.author.name) | upper -}}
							<meta itemprop="name" content="{{ post.author.name | e('html_attr') }}" />
						</p>
					{%- endif -%}
				</div>

				{%- if post.thumbnail -%}
					<div class="col-span-full lg:col-span-6">
						<div class="border-cream-soft aspect-4/3 overflow-hidden rounded-10 border">
							{{-
								include(
									'components/image.html.twig',
									{
										image: post.thumbnail,
										classes: ['size-full object-cover object-center'],
										loading: 'eager',
										attributes: {
											itemprop: 'image'
										}
									},
									with_context = false
								)
							-}}
						</div>
					</div>
				{%- endif -%}
			</div>
		</section>

		{%- if post.content -%}
			<section class="pb-26 pt-20" aria-label="{{ __('Article content', 'agencecinq') }}">
				<div class="container">
					<div
						class="wysiwyg text-base text-taupe max-w-180 [&_a]:text-pistachio [&_h2]:mb-5 [&_h2]:text-title-lg [&_h2]:text-cream [&_h2:not(:first-child)]:mt-10 [&_h3]:mb-4 [&_h3]:text-title-md [&_h3]:text-cream [&_h3:not(:first-child)]:mt-10 [&_p]:mb-5 [&_p]:text-base"
						itemprop="articleBody"
					>
						{{- post.content -}}
					</div>
				</div>
			</section>
		{%- endif -%}

		{%- set related_items = post.meta('related_cases') | default([]) | filter(item => item.case_study) -%}
		{%- if related_items | length -%}
			{%- set item_span = related_items | length == 2 ? 'col-span-full md:col-span-6' : 'col-span-full lg:col-span-4' -%}

			<section
				class="bg-dark-gray py-18 lg:py-26"
				aria-labelledby="related-cases-title"
				itemscope
				itemtype="https://schema.org/ItemList"
			>
				<div class="container space-y-10">
					<h2 id="related-cases-title" class="text-title-lg" itemprop="name">
						{{- __('À lire aussi', 'agencecinq') -}}
					</h2>

					<meta itemprop="numberOfItems" content="{{ related_items | length }}" />

					<ul class="layout-grid gap-y-6">
						{%- for item in related_items -%}
							{%- set case = get_post(item.case_study) -%}

							{%- if case -%}
								<li
									class="{{ item_span }}"
									itemprop="itemListElement"
									itemscope
									itemtype="https://schema.org/ListItem"
								>
									<meta itemprop="position" content="{{ loop.index }}" />
									{{-
										include(
											'components/tease-related-case.html.twig',
											{
												post: case,
												text: item.text
											},
											with_context: false
										)
									-}}
								</li>
							{%- endif -%}
						{%- endfor -%}
					</ul>
				</div>
			</section>
		{%- endif -%}

		{%- set cta_link = theme.contact.link | default({}) -%}
		{%- if cta_link.url is defined and cta_link.url -%}
			{%- set cta_link = cta_link | merge({
				title: cta_link.title | default(__('Réserver 20 minutes', 'agencecinq'))
			}) -%}
		{%- endif -%}

		{{-
			include(
				'blocks/call-to-action.html.twig',
				{
					block: {
						id: 'post-closing-cta',
						content: {
							title: __('On commence par 20 minutes.', 'agencecinq'),
							heading: 'h2',
							text: __(
								"On regarde votre site en direct, on vous dit si on est le bon interlocuteur, et on vous donne un ordre de grandeur. Le diagnostic, s'il a du sens, se décide à la fin de l'appel.",
								'agencecinq'
							),
							link: cta_link
						}
					}
				},
				with_context = false
			)
		-}}
	</main>
{%- endblock -%}
