{#
 # Single post
 #
 # Figma T14 · Article: the Post header, the breadcrumb, the title in H1, the lede, the author and the date,
 # with the update date when the post changed another day, then the image; the post as Rich text; the
 # Profile of the author; the Post row of the posts to read next, from its categories; then the Signup form
 # of the page for posts.
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	{%- set author = post.author -%}
	{%- set byline = [ author.name, author.meta( 'job' ) ] | filter( part => part ) | join( ', ' ) -%}
	{%- set related = post.related -%}
	{%- set signup = post.signup_form -%}

	<main id="content" role="main">
		<article aria-labelledby="post-title">
			<header class="container flex flex-col gap-6 pt-10 pb-8 lg:gap-8 lg:pt-20 lg:pb-14">
				<div class="flex max-w-205 flex-col gap-5">
					{{- include( 'components/breadcrumb.html.twig', with_context: false ) -}}
					<h1 id="post-title" class="text-title-xxl text-primary">{{- post.title -}}</h1>
					{%- if post.post_excerpt -%}
						<p class="text-body text-xl">{{- post.post_excerpt -}}</p>
					{%- endif -%}
					<div class="flex items-center gap-3">
						{{-
							include(
								'components/avatar.html.twig',
								{ image: author.meta( 'portrait' ) },
								with_context: false
							)
						-}}
						<p class="flex flex-col gap-0.5">
							{%- if byline -%}
								<span class="text-button text-primary">{{- byline -}}</span>
							{%- endif -%}
							<span class="text-muted text-sm">
								<time datetime="{{ post.date( 'c' ) }}">{{- post.date -}}</time>
								{%- if post.modified_date( 'Y-m-d' ) != post.date( 'Y-m-d' ) -%}
									{{- ' · ' -}}
									<time datetime="{{ post.modified_date( 'c' ) }}">
										{{- __( 'Updated on %s', 'agencecinq' ) | format( post.modified_date ) -}}
									</time>
								{%- endif -%}
								{%- if post.reading_time -%}
									{{- ' · '
										~ ( __( '%d min read', 'agencecinq' ) | format( post.reading_time ) ) -}}
								{%- endif -%}
							</span>
						</p>
					</div>
				</div>
				{%- if post.thumbnail -%}
					<div class="bg-media aspect-16/10 overflow-hidden rounded-md lg:aspect-31/14">
						{{-
							include(
								'components/image.html.twig',
								{
									image: post.thumbnail,
									sizes: '(min-width: 90rem) 77.5rem, (min-width: 64rem) calc(100vw - 12.5rem), calc(100vw - 2.5rem)',
									loading: 'eager',
									classes: [ 'size-full object-cover' ],
									attributes: { fetchpriority: 'high' },
								},
								with_context: false
							)
						-}}
					</div>
				{%- endif -%}
			</header>

			{%- if post.content -%}
				<div class="container py-10 lg:py-20">
					<div class="wysiwyg text-body max-w-180 text-lg">
						{{- post.content -}}
					</div>
				</div>
			{%- endif -%}

			{%- if author -%}
				<footer class="container py-8 lg:py-14">
					<div class="border-default flex max-w-205 flex-col gap-6 border-t py-8 lg:flex-row">
						{{-
							include(
								'components/avatar.html.twig',
								{
									image: author.meta( 'portrait' ),
									size: 'large',
								},
								with_context: false
							)
						-}}
						<div class="flex flex-col items-start gap-2">
							<p class="text-title-md text-primary">{{- author.name -}}</p>
							{%- if author.description -%}
								<p class="text-body text-base">{{- author.description -}}</p>
							{%- endif -%}
							<a
								href="{{ author.link }}"
								class="text-button text-primary focus-visible:outline-focus-ring underline focus-visible:outline-2 focus-visible:outline-offset-2"
							>
								{{-
									__( 'All posts by %s', 'agencecinq' ) | format(
										author.first_name | default( author.name )
									)
								-}}
							</a>
						</div>
					</div>
				</footer>
			{%- endif -%}
		</article>

		{%- if related | length -%}
			<section class="border-default border-t py-14 lg:py-26" aria-labelledby="post-row-title">
				<div class="container flex flex-col gap-6 lg:gap-10">
					<h2 id="post-row-title" class="text-title-xl text-primary">
						{{- __( 'Read next', 'agencecinq' ) -}}
					</h2>
					<ul class="layout-grid gap-y-8">
						{%- for item in related -%}
							<li class="col-span-full lg:col-span-4">
								{{-
									include(
										'components/article-card.html.twig',
										{
											post: item,
											heading: 'h3',
											sizes: '(min-width: 90rem) 24.8rem, (min-width: 64rem) calc((100vw - 15.5rem) / 3), calc(100vw - 2.5rem)',
										},
										with_context: false
									)
								-}}
							</li>
						{%- endfor -%}
					</ul>
				</div>
			</section>
		{%- endif -%}

		{%- if signup -%}
			{{- include( 'blocks/signup-form.html.twig', { block: signup } ) -}}
		{%- endif -%}
	</main>
{%- endblock -%}
