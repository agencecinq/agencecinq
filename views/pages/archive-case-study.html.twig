{#
 # Page: Archive: Case study
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main">
		<div class="rounded-b-25 lg:rounded-b-50 relative z-3 -mb-6.25 lg:-mb-12.5">
			<div class="layout-grid container gap-y-5 pt-5 pb-20 lg:pt-12.5">
				<div class="col-span-full space-y-15 text-center lg:col-span-10 lg:col-start-2">
					<div class="space-y-5">
						{{- yoast_breadcrumb() -}}
						<h1 class="text-title-xl text-pistachio">
							{{- title | default(__('Case studies', 'agencecinq')) -}}
						</h1>
					</div>

					{%- if categories | length -%}
						<ul
							class="scrollbar-hidden -mx-2.5 flex justify-center-safe gap-3 overflow-x-auto px-2.5 lg:mx-0 lg:flex-wrap lg:px-0"
						>
							<li class="whitespace-nowrap">
								{{-
									include(
										'components/chip.html.twig',
										{
											title: __('All case studies', 'agencecinq'),
											url: case_studies_url,
											active: not category,
											mode: 'dark'
										}
									)
								-}}
							</li>
							{%- for item in categories -%}
								<li class="whitespace-nowrap">
									{{-
										include(
											'components/chip.html.twig',
											{
												title: item.name,
												url: item.link,
												active: category and category.term_id == item.term_id,
												mode: 'dark'
											}
										)
									-}}
								</li>
							{%- endfor -%}
						</ul>
					{%- endif -%}
				</div>
			</div>
		</div>

		<div class="pt-27.5 pb-20 lg:pt-32.5">
			<div class="layout-grid container gap-y-10 lg:gap-y-20">
				{%- for post in posts -%}
					<div class="col-span-6 lg:col-span-4">
						{{-
							include(
								'components/tease-case-study.html.twig',
								{
									post: post
								}
							)
						-}}
					</div>
				{%- else -%}
					<p class="col-span-full text-center">
						{{- __('No case studies found.', 'agencecinq') -}}
					</p>
				{%- endfor -%}

				{{-
					include(
						'components/pagination.html.twig',
						{
							classes: ['col-span-full', 'mx-auto'],
							pagination: posts.pagination({
								mid_size: 1
							})
						}
					)
				-}}
			</div>
		</div>
	</main>
{%- endblock -%}
