{#
 # Maintenance
 #
 # Figma T21 · Maintenance, laid out like the 404: the title in H1, the text, the booking link and the one to
 # write to us. Header and footer keep the logo and the contact, without the navigation: every page answers
 # with this one.
 #
 # @package WordPress
 # @subpackage AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- set contact = theme.contact | default( {} ) -%}
{%- set phone = contact.phone | default( '' ) | replace( { ' ': '&nbsp;' } ) -%}

{%- block header -%}
	<header role="banner" class="text-label border-cream/11 border-b bg-black py-[0.78125rem]">
		<div class="container flex items-center justify-between gap-4 lg:gap-6">
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'logo',
						classes: [ 'block h-[1.190625rem] w-16' ],
						attributes: {
							role: 'img',
							'aria-label': site.name,
						},
					},
					with_context: false
				)
			-}}

			{{-
				include(
					'components/button.html.twig',
					contact.link | default( {} ) | merge( { variant: 'tertiary' } ),
					with_context: false
				)
			-}}
		</div>
	</header>
{%- endblock -%}

{%- block content -%}
	<main id="content" role="main">
		<section aria-labelledby="maintenance-title">
			<div class="container flex flex-col items-center space-y-8 py-31.5 text-center lg:py-42">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: [ 'text-pistachio h-[1.959rem] w-14' ],
							attributes: { 'aria-hidden': 'true' },
						},
						with_context: false
					)
				-}}

				<div class="flex w-full flex-col items-center space-y-12">
					<div class="flex w-full flex-col items-center space-y-6">
						<h1 id="maintenance-title" class="text-title-xxl text-balance">{{- title -}}</h1>

						<p class="text-taupe max-w-130 text-lg">
							{{-
								__(
									'A new version of agencecinq.com is going live. In the meantime, you can still reach us at %1$s, at %2$s, or on a 30-minute call.',
									'agencecinq'
								) | format( phone, contact.email )
							-}}
						</p>
					</div>

					<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
						{{-
							include(
								'components/button.html.twig',
								contact.link | default( {} ) | merge( { variant: 'primary' } ),
								with_context: false
							)
						-}}

						{%- if contact.email -%}
							{{-
								include(
									'components/button.html.twig',
									{
										title: __( 'Write to %s', 'agencecinq' ) | format( contact.email ),
										url: 'mailto:' ~ contact.email,
										variant: 'secondary',
									},
									with_context: false
								)
							-}}
						{%- endif -%}
					</div>
				</div>
			</div>
		</section>
	</main>
{%- endblock -%}

{%- block footer -%}
	{%- set locations = contact.locations | default( [] ) | filter( location => location.title ) -%}

	<footer
		role="contentinfo"
		class="text-stone text-label bg-dark-gray border-cream-soft border-t pt-18 pb-8 lg:pt-31 lg:pb-8.5"
	>
		<div class="container space-y-12 lg:space-y-20">
			<div class="layout-grid gap-y-10">
				<div class="col-span-full space-y-4 lg:col-span-4">
					{{-
						include(
							'svg/use.html.twig',
							{
								icon: 'logo',
								classes: [ 'text-cream block h-[1.339375rem] w-18' ],
								attributes: { 'aria-hidden': 'true' },
							},
							with_context: false
						)
					-}}

					{%- if theme.footer.text -%}
						<p class="text-taupe text-sm">{{- theme.footer.text -}}</p>
					{%- endif -%}
				</div>

				<div class="col-span-full space-y-3 lg:col-span-4">
					<h2 class="text-eyebrow">{{- __( 'Contact', 'agencecinq' ) -}}</h2>

					<ul class="space-y-1">
						{%- if contact.phone -%}
							<li class="text-pistachio">
								<a href="tel:{{ contact.phone | tel }}">{{- contact.phone -}}</a>
							</li>
						{%- endif -%}

						{%- if contact.email -%}
							<li class="text-pistachio">
								<a href="mailto:{{ contact.email }}">{{- contact.email -}}</a>
							</li>
						{%- endif -%}

						{%- for location in locations -%}
							<li>{{- location.title -}}</li>
						{%- endfor -%}

						{%- if contact.link.url -%}
							<li class="text-pistachio">
								<a
									href="{{ contact.link.url }}"
									{{ contact.link.target == '_blank'
										? 'target="_blank" rel="noopener noreferrer"' }}
								>
									{{- contact.link.title -}}
								</a>
							</li>
						{%- endif -%}
					</ul>
				</div>
			</div>

			<div class="border-cream-soft flex items-center gap-2 border-t pt-6">
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'mark',
							classes: [ 'w-2.5 h-[0.35rem]' ],
							attributes: { 'aria-hidden': 'true' },
						},
						with_context: false
					)
				-}}

				{{- '&copy;&nbsp;' ~ ( 'now' | date( 'Y' ) ) ~ '&nbsp;' ~ site.name
					~ '&nbsp;&middot;&nbsp;' -}}
				{{- __( 'Made with care', 'agencecinq' ) -}}
			</div>
		</div>
	</footer>
{%- endblock -%}
