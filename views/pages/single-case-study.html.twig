{#
 # Single case study
 #
 # Figma T11 · Case study: the breadcrumb, then the Page header of the case from its hero, « Client case »,
 # the title, the lead, the client line, the buttons and the site before and after, then its blocks.
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	{%- set hero = post.meta( 'hero' ).content | default( {} ) -%}
	{%- set meta =
		[
			__( 'Client: %s', 'agencecinq' ) | format( post.client ),
			post.platform ? __( 'Platform: %s', 'agencecinq' ) | format( post.platform ),
			post.year ? __( 'Live: %s', 'agencecinq' ) | format( post.year ),
		]
			| filter( part => part )
			| join( ' · ' )
	-%}

	<main id="content" role="main">
		{{-
			include(
				'components/breadcrumb.html.twig',
				{ classes: [ 'container pt-4 lg:pt-6' ] },
				with_context: false
			)
		-}}
		{{-
			include(
				'components/page-header.html.twig',
				{
					eyebrow: __( 'Client case', 'agencecinq' ),
					title: hero.title | default( post.title ),
					text: hero.text,
					meta: meta,
					links: hero.links,
					before: { image: post.before },
					after: { image: post.screenshot },
					classes: [ 'pt-20 pb-10 lg:pt-34 lg:pb-20' ],
				},
				with_context: false
			)
		-}}

		{{- include( 'blocks/blocks.html.twig', { blocks: post.meta( 'blocks' ) } ) -}}
	</main>
{%- endblock -%}
