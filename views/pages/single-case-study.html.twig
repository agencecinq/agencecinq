{#
 # Single case study
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main" itemscope itemtype="https://schema.org/Article">
		{%- if
			post.meta('hero').content.client
				or post.meta('hero').content.platform
				or post.meta('hero').content.year
				or post.meta('hero').content.title
				or post.meta('hero').content.text
				or post.screenshot
				or post.video
				or post.title -%}
			<section class="py-18 lg:py-26" aria-labelledby="case-hero-title">
				<div class="container space-y-18">
					<div class="space-y-8">
						<header class="space-y-6">
							{%- if
								post.meta('hero').content.client
									or post.meta('hero').content.platform
									or post.meta('hero').content.year -%}
								<p class="text-label text-taupe uppercase">
									{%- if post.meta('hero').content.client -%}
										<span itemprop="about" itemscope itemtype="https://schema.org/Organization">
											<span itemprop="name">{{- post.meta('hero').content.client -}}</span>
										</span>
									{%- endif -%}
									{%- if post.meta('hero').content.platform -%}
										{{- post.meta('hero').content.client ? ' · ' -}}
										<span>{{- post.meta('hero').content.platform -}}</span>
									{%- endif -%}
									{%- if post.meta('hero').content.year -%}
										{{- post.meta('hero').content.client or post.meta('hero').content.platform
											? ' · ' -}}
										<time datetime="{{ post.meta('hero').content.year }}" itemprop="dateCreated">
											{{- post.meta('hero').content.year -}}
										</time>
									{%- endif -%}
								</p>
							{%- endif -%}

							<h1 id="case-hero-title" class="text-title-xxl max-w-250" itemprop="headline">
								{{- post.meta('hero').content.title | default(post.title) | raw -}}
							</h1>
						</header>

						{%- if post.meta('hero').content.text -%}
							<p class="text-taupe max-w-190 text-xl" itemprop="description">
								{{- post.meta('hero').content.text | raw -}}
							</p>
						{%- endif -%}
					</div>

					{{-
						include(
							'components/browser-frame.html.twig',
							{
								image: post.screenshot,
								video: post.video,
								poster: post.poster,
								classes: ['w-full'],
								loading: 'eager',
								attributes: {
									itemprop: 'image'
								}
							},
							with_context: false
						)
					-}}
				</div>
			</section>
		{%- endif -%}

		{{-
			include(
				'blocks/blocks.html.twig',
				{
					blocks: post.meta('blocks')
				}
			)
		-}}
	</main>
{%- endblock -%}
