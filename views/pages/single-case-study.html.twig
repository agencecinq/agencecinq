{#
 # Single case study
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main" itemscope itemtype="https://schema.org/Article">
		{%- block header -%}
			<div class="absolute inset-x-0 top-0 z-10">
				{{-
					include(
						'header.html.twig',
						{
							classes: ['relative z-10']
						}
					)
				-}}
			</div>
		{%- endblock -%}

		{{-
			include(
				'blocks/blocks.html.twig',
				{
					blocks: post.meta('blocks')
				}
			)
		-}}
	</main>
{%- endblock -%}
