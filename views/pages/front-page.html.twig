{#
 # Front page
 #
 # Figma Section/Hero, Visual=Diff: the text and its two buttons on eight columns, the paragraph on seven,
 # the diff of a site on the last four.
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	{%- set hero = post.meta( 'hero' ) | default( {} ) -%}
	{%- set content = hero.content | default( {} ) -%}
	{%- set links =
		content.links | default( [] ) | filter( link => link.title | default( false ) )
	-%}
	{%- set diff = hero.diff | default( {} ) -%}
	{%- set removed =
		diff.removed | default( [] ) | map( line => line.text ) | filter( text => text )
	-%}
	{%- set added = diff.added | default( [] ) | map( line => line.text ) | filter( text => text ) -%}

	<main id="content" role="main">
		<section class="py-14 lg:pt-34 lg:pb-26" aria-labelledby="hero-home-title">
			<div class="layout-grid container items-start gap-y-10">
				<div class="col-span-full grid grid-cols-subgrid gap-y-6 lg:col-span-8 lg:gap-y-8">
					{%- if content.eyebrow -%}
						<p class="text-eyebrow text-muted col-span-full">{{- content.eyebrow -}}</p>
					{%- endif -%}

					<h1 id="hero-home-title" class="text-title-3xl text-primary col-span-full">
						{{- content.title | default( post.title ) | raw -}}
					</h1>

					{%- if content.text -%}
						<p class="text-body col-span-full text-xl lg:col-span-7">{{- content.text -}}</p>
					{%- endif -%}

					{%- if links | length -%}
						<div class="col-span-full flex flex-wrap gap-4">
							{%- for link in links -%}
								{{-
									include(
										'components/button.html.twig',
										link | merge( {
											variant: loop.first ? 'primary' : 'secondary',
											arrow: loop.first,
										} ),
										with_context: false
									)
								-}}
							{%- endfor -%}
						</div>
					{%- endif -%}
				</div>

				{%- if ( removed | length ) or ( added | length ) -%}
					{{-
						include(
							'components/diff-block.html.twig',
							{
								address: diff.address,
								note: diff.note,
								removed: removed,
								added: added,
								link: diff.link,
								classes: [ 'col-span-full lg:col-span-4' ],
							},
							with_context: false
						)
					-}}
				{%- endif -%}
			</div>
		</section>

		{{- include( 'blocks/blocks.html.twig', { blocks: post.meta( 'blocks' ) } ) -}}
	</main>
{%- endblock -%}
