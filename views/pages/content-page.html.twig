{#
 # Content page
 # Page Hero (overline, title, lead, links) + Editorial Prose (WYSIWYG).
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	{%- set content = post.meta('content') | default({}) -%}
	{%- set overline = content.overline | default('') -%}
	{%- set title = content.title | default(post.title) -%}
	{%- set text = content.text | default('') -%}
	{%- set links = content.links | default([]) -%}
	{%- set body = content.body | default('') -%}

	<main id="content" role="main">
		{# Section · Page Hero — padding 104 / 80 #}
		<section class="pt-26 pb-20" {{ title ? 'aria-labelledby="content-page-title"' }}>
			<div class="layout-grid container">
				<div class="col-span-full space-y-14 lg:col-span-9">
					{%- if overline or title or text -%}
						<div class="space-y-8">
							{%- if overline or title -%}
								<header class="space-y-6">
									{%- if overline -%}
										<p class="text-label text-taupe uppercase">
											{{- overline -}}
										</p>
									{%- endif -%}

									{%- if title -%}
										<h1 id="content-page-title" class="text-title-xxl">
											{{- title -}}
										</h1>
									{%- endif -%}
								</header>
							{%- endif -%}

							{%- if text -%}
								<p class="text-taupe max-w-190 text-xl">
									{{- text | raw -}}
								</p>
							{%- endif -%}
						</div>
					{%- endif -%}

					{%- if links | length -%}
						<div class="flex flex-wrap items-center gap-4">
							{%- for item in links -%}
								{%- set link = item.link | default({}) -%}
								{{-
									include(
										'components/button.html.twig',
										link
											| merge({
												variant: loop.first ? 'primary' : 'secondary'
											}),
										with_context = false
									)
								-}}
							{%- endfor -%}
						</div>
					{%- endif -%}
				</div>
			</div>
		</section>

		{# Section · Editorial Prose — 720px column, padding 104 #}
		{%- if body -%}
			<section class="py-26" aria-label="{{ __('Page content', 'agencecinq') }}">
				<div class="container">
					<div
						class="wysiwyg text-base text-taupe max-w-180 [&_a]:text-pistachio [&_h2]:mb-8 [&_h2]:text-title-xl [&_h2]:text-cream [&_h2:not(:first-child)]:mt-10 [&_h3]:mb-4 [&_h3]:text-title-lg [&_h3]:text-cream [&_h3:not(:first-child)]:mt-10 [&_ol]:text-base [&_p]:mb-5 [&_p]:text-base [&_ul]:text-base"
					>
						{{- body | raw -}}
					</div>
				</div>
			</section>
		{%- endif -%}
	</main>
{%- endblock -%}
