{#
 # Page: Archive: Post
 #
 # @package AgenceCinq
 #}

{% extends 'index.html.twig' %}

{%- block content -%}
	<main id="content" role="main">
		<div class="relative z-3 -mb-6.25 lg:-mb-12.5">
			<div class="layout-grid container gap-y-5 pt-5 pb-20 lg:pt-12.5">
				<div class="col-span-full space-y-15 text-center lg:col-span-10 lg:col-start-2">
					<div class="space-y-5">
						{{- yoast_breadcrumb() -}}
						<h1 class="text-title-xl text-accent-default">
							{{- post.hero.title | default( post.title ) -}}
						</h1>
					</div>

					<ul
						class="scrollbar-hidden -mx-2.5 flex justify-center-safe gap-3 overflow-x-auto px-2.5 lg:mx-0 lg:flex-wrap lg:px-0"
					>
						<li class="whitespace-nowrap">
							{{-
								include(
									'components/chip.html.twig',
									{
										title: __( 'All posts', 'agencecinq' ),
										url: posts_url,
										active: category.term_id == post.category.term_id,
									}
								)
							-}}
						</li>
						{%- for category in post.categories -%}
							<li class="whitespace-nowrap">
								{{-
									include(
										'components/chip.html.twig',
										{
											title: category.name,
											url: category.link,
											active: category.term_id == post.category.term_id,
										}
									)
								-}}
							</li>
						{%- endfor -%}
					</ul>
				</div>
			</div>
		</div>

		<div class="pt-27.5 pb-20 lg:pt-32.5">
			<div class="layout-grid container gap-y-10 lg:gap-y-20">
				{%- for post in posts -%}
					<div
						class="{{
							html_classes( 'lg:col-span-4', loop.first ? 'col-span-full' : 'col-span-6' )
						}}"
					>
						{{- include( 'components/tease-post.html.twig', { post: post } ) -}}
					</div>

					{%- if loop.index == 8 or ( loop.last and ( posts | length ) < 10 ) -%}
						<div class="col-span-full lg:col-span-4">
							<div
								class="bg-accent-default flex h-full flex-col justify-between gap-2.5 rounded-lg px-6.25 py-8 lg:gap-5"
							>
								<div class="space-y-5">
									<h2 class="text-base">
										{{- __( 'Subscribe to our newsletter', 'agencecinq' ) -}}
									</h2>
									<p class="text-xl">
										{{- __( 'News and updates from Agence Cinq', 'agencecinq' ) -}}
									</p>
								</div>
								{{-
									include( 'components/form-newsletter.html.twig', { instance: loop.index + 1 } )
								-}}
							</div>
						</div>
					{%- endif -%}
				{%- endfor -%}

				{{-
					include(
						'components/pagination.html.twig',
						{
							classes: [ 'col-span-full', 'mx-auto' ],
							pagination: posts.pagination( { mid_size: 1 } ),
						}
					)
				-}}
			</div>
		</div>
	</main>
{%- endblock -%}
