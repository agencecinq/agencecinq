{#
 # Index
 #
 # @package AgenceCinq
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class('no-js no-touch antialiased') }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{{ function('wp_head') }}
	</head>

	<body {{ body_class('text-cream bg-black antialiased') }}>
		{{- function('wp_body_open ') -}}

		{%- block header -%}
			{{-
				include(
					'header.html.twig',
					{
						classes: ['sticky top-0 z-10']
					}
				)
			-}}
		{%- endblock -%}
		{%- block content -%}
			<main id="content" role="main">
				<div class="container space-y-5 pt-5 pb-20 lg:space-y-20 lg:pt-12.5">
					{{ yoast_breadcrumb() }}
					<h1 class="text-title-xl text-pistachio">{{- post.title -}}</h1>
				</div>

				{%- if post.content -%}
					<div class="layout-grid container gap-y-5 pt-26.25 pb-20 lg:pt-32.5">
						<div class="wysiwyg col-span-full lg:col-span-6 lg:col-start-4">
							{{- post.content -}}
						</div>
					</div>
				{%- endif -%}

				{{-
					include(
						'blocks/blocks.html.twig',
						{
							blocks: post.meta('blocks')
						}
					)
				-}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include('footer.html.twig') -}}
		{%- endblock -%}{{- function('wp_footer') -}}<div id="svg-sprite" style="display: none;">
			{{- include('public/sprite.svg', ignore_missing = true) -}}
		</div>

		{{- include('components/grid.html.twig') -}}
	</body>
</html>
