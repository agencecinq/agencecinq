{#
 # Index
 #
 # Document shell + default page layout, Figma T18 · Legal page: the Page header, then the editor content as
 # Rich text, then optional flexible blocks.
 #
 # @package AgenceCinq
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}
<!DOCTYPE html>

<html
	itemscope
	itemtype="http://schema.org/WebPage"
	{{ html_class( 'antialiased' ) }}
	{{ site.language_attributes }}
>
	<head>
		<meta charset="{{ site.charset }}" />
		<link rel="profile" href="http://gmpg.org/xfn/11" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		{{ function( 'wp_head' ) }}
	</head>

	<body {{ body_class( 'antialiased' ) }} data-scheme="">
		{{- function( 'wp_body_open ' ) -}}

		{%- block header -%}
			{{- include( 'header.html.twig', { classes: [ 'sticky top-0 z-10' ] } ) -}}
		{%- endblock -%}

		{%- block content -%}
			<main id="content" role="main">
				{{-
					include(
						'components/page-header.html.twig',
						{
							eyebrow: post.meta( 'overline' ),
							title: post.title,
							text: post.post_excerpt,
							links: post.meta( 'links' ),
							classes: [ 'pt-20 pb-10 lg:pt-34 lg:pb-20' ],
						},
						with_context: false
					)
				-}}

				{%- if post.content -%}
					<div class="container py-10 lg:py-20">
						<div class="wysiwyg text-body max-w-180 text-lg">
							{{- post.content -}}
						</div>
					</div>
				{%- endif -%}

				{{- include( 'blocks/blocks.html.twig', { blocks: post.meta( 'blocks' ) } ) -}}
			</main>
		{%- endblock -%}

		{%- block footer -%}
			{{- include( 'footer.html.twig' ) -}}
		{%- endblock -%}

		{{- function( 'wp_footer' ) -}}

		<div id="svg-sprite" style="display: none;">
			{{- include( 'public/sprite.svg', ignore_missing: true ) -}}
		</div>

		<div class="pointer-events-none fixed inset-x-4 bottom-4 z-30 lg:inset-x-0 lg:bottom-6">
			<div class="flex flex-col items-end gap-3 lg:container">
				{{-
					include(
						'components/toast.html.twig',
						{
							id: 'toast-success',
							type: 'success',
						},
						with_context: false
					)
				-}}
				{{-
					include(
						'components/toast.html.twig',
						{
							id: 'toast-error',
							type: 'error',
						},
						with_context: false
					)
				-}}
			</div>
		</div>

		{{-
			include(
				'components/consent.html.twig',
				{ privacy_policy_url: privacy_policy_url },
				with_context: false
			)
		-}}

		{{- include( 'components/grid.html.twig' ) -}}
		{{- include( 'components/scheme.html.twig' ) -}}
	</body>
</html>
