{#
 # Blocks: Pricing Tiers
 # Title, intro, then up to three pricing cards. One card can be featured.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

{%- set items = block.items | default([]) | filter(item => item.title or item.price or item.badge or item.features) -%}

<section
	id="{{ block.id }}"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
	itemscope
	itemtype="https://schema.org/OfferCatalog"
>
	<div class="container space-y-14">
		{%- if block.content.title or block.content.text -%}
			<header class="space-y-6">
				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-225" itemprop="name">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-base text-taupe max-w-180" itemprop="description">
						{{- block.content.text | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length -%}
			<ul class="grid grid-cols-1 items-start gap-y-8 lg:grid-cols-3 lg:gap-x-6">
				{%- for item in items -%}
					<li
						class="flex"
						itemprop="itemListElement"
						itemscope
						itemtype="https://schema.org/Offer"
					>
						{{-
							include(
								'components/pricing-tier.html.twig',
								{
									title: item.title,
									price: item.price,
									features: item.features,
									featured: item.featured,
									badge: item.badge
								},
								with_context: false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>
