{#
 # Blocks: Pricing Tiers
 # Title, intro, then the pricing cards. One card can be featured.
 # Sources « catalogue » (packages), « retainers » and « modules »: the cards of a platform, from Central.
 # Source « manual »: up to four cards typed in the block, with the fields of a package.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id,
		}
	)
-}}

{%- if block.source in [ 'catalogue', 'retainers', 'modules' ] -%}
	{%- set catalogue = catalogue() -%}
	{%- set items = catalogue ? catalogue.tiers( block.source, block.catalogue | default( {} ) ) : []
	-%}
{%- else -%}
	{%- set items =
		block.items
			| default( [] )
			| filter( item => item.name or item.priceExclVat is not empty or item.badge or item.included )
	-%}
{%- endif -%}

<section
	id="{{ block.id }}"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
	itemscope
	itemtype="https://schema.org/OfferCatalog"
>
	<div class="container space-y-14">
		{%- if block.content.title or block.content.text -%}
			<header class="space-y-6">
				{%- if block.content.title -%}
					<{{ block.content.heading | default( 'h2' ) }}
						id="{{ block.id }}-title"
						class="text-title-xl max-w-225"
						itemprop="name"
					>
						{{- block.content.title -}}
					</{{ block.content.heading | default( 'h2' ) }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-muted max-w-180 text-base" itemprop="description">
						{{- block.content.text | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length -%}
			<ul
				class="{{
					html_classes(
						'grid grid-cols-1 gap-y-8 md:grid-cols-2 md:gap-x-6',
						{
							'lg:grid-cols-3': ( items | length ) == 3,
							'xl:grid-cols-4': ( items | length ) >= 4,
						}
					)
				}}"
			>
				{%- set reserve_badge = items has some item => item.badge -%}

				{%- for item in items -%}
					<li class="flex" itemprop="itemListElement" itemscope itemtype="https://schema.org/Offer">
						{{-
							include(
								'components/pricing-tier.html.twig',
								item | merge( { reserve_badge: reserve_badge } ),
								with_context: false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>
