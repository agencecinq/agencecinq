{#
 # Blocks: Pricing Tiers
 # Title, intro, then the pricing cards. One card can be featured.
 # Source « catalogue »: every package of a platform, from Central, with its first four included lines.
 # Source « manual »: up to four cards typed in the block.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id
		}
	)
-}}

{%- if block.source == 'catalogue' -%}
	{%- set catalogue = catalogue() -%}
	{%- set items = [] -%}

	{%- for package in catalogue ? catalogue.packages(block.catalogue.platform) : [] -%}
		{%- set featured = package.code == block.catalogue.featured -%}
		{%- set items =
			items | merge(
				[
					{
						title: package.name,
						price: catalogue.price(package),
						features: package.included
							| slice(0, 4)
							| map(
								text => {
									text: text
								}
							),
						featured: featured,
						badge: featured ? block.catalogue.badge : ''
					}
				]
			)
		-%}
	{%- endfor -%}
{%- else -%}
	{%- set items =
		block.items
			| default([])
			| filter(item => item.title or item.price or item.badge or item.features)
	-%}
{%- endif -%}

<section
	id="{{ block.id }}"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
	itemscope
	itemtype="https://schema.org/OfferCatalog"
>
	<div class="container space-y-14">
		{%- if block.content.title or block.content.text -%}
			<header class="space-y-6">
				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }}
						id="{{ block.id }}-title"
						class="text-title-xl max-w-225"
						itemprop="name"
					>
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-taupe max-w-180 text-base" itemprop="description">
						{{- block.content.text | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length -%}
			<ul
				class="{{
				html_classes(
					'grid grid-cols-1 gap-y-8 lg:gap-x-6',
					{
						'lg:grid-cols-2': (items | length) == 2,
						'lg:grid-cols-3': (items | length) == 3,
						'lg:grid-cols-4': (items | length) >= 4
					}
				)
				}}"
			>
				{%- set reserve_badge = items has some item => item.badge -%}

				{%- for item in items -%}
					<li class="flex" itemprop="itemListElement" itemscope itemtype="https://schema.org/Offer">
						{{-
							include(
								'components/pricing-tier.html.twig',
								{
									title: item.title,
									price: item.price,
									features: item.features,
									featured: item.featured,
									badge: item.badge,
									reserve_badge: reserve_badge
								},
								with_context = false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>
