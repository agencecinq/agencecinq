{#
 # Blocks: Module Catalog
 # Title, intro, then one column per platform listing every module and its price, from Central.
 # Prices add up to the package as they are: no markup, no cap on the number of modules.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id,
		}
	)
-}}

{%- set catalogue = catalogue() -%}
{%- set platforms = catalogue
	? catalogue.platforms() | filter(
		platform => not block.platforms or platform.id in block.platforms
	)
	: []
-%}

<section id="{{ block.id }}" {{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}>
	<div class="container space-y-14">
		{%- if block.content.title or block.content.text -%}
			<header class="space-y-6">
				{%- if block.content.title -%}
					<{{ block.content.heading | default( 'h2' ) }}
						id="{{ block.id }}-title"
						class="text-title-xl"
					>
						{{- block.content.title -}}
					</{{ block.content.heading | default( 'h2' ) }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-muted max-w-180 text-base">{{- block.content.text | raw -}}</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if platforms | length -%}
			<div class="grid grid-cols-1 gap-y-14 lg:grid-cols-2 lg:gap-x-20">
				{%- for platform in platforms -%}
					{%- set modules = catalogue.modules( platform.id ) -%}

					{%- if modules | length -%}
						<section
							class="space-y-5"
							aria-labelledby="{{ block.id }}-{{ platform.id }}"
							itemscope
							itemtype="https://schema.org/OfferCatalog"
						>
							<h3
								id="{{ block.id }}-{{ platform.id }}"
								class="text-eyebrow text-subtle"
								itemprop="name"
							>
								{{- platform.label -}}
							</h3>

							<ul>
								{%- for module in modules -%}
									<li
										class="border-subtle flex items-center justify-between gap-4 border-t py-3"
										itemprop="itemListElement"
										itemscope
										itemtype="https://schema.org/Offer"
									>
										<span class="text-muted text-sm" itemprop="name">{{- module.name -}}</span>
										<span class="text-primary text-sm whitespace-nowrap">
											{{- catalogue.price( module, true ) -}}
										</span>
									</li>
								{%- endfor -%}
							</ul>
						</section>
					{%- endif -%}
				{%- endfor -%}
			</div>
		{%- endif -%}
	</div>
</section>
