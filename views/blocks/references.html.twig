{#
 # Blocks: References
 # First case study is featured; the rest follow in a grid.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

<section
	id="{{ block.id }}"
	class="bg-black text-cream"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
	{{ block.items | length ? 'itemscope itemtype="https://schema.org/ItemList"' }}
>
	<div class="container space-y-18">
		{%- if block.content.overline or block.content.title -%}
			<header class="space-y-6">
				{{-
					include(
						'components/eyebrow.html.twig',
						{
							title: block.content.overline
						},
						with_context: false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-180">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if block.items | length -%}
		{% set posts = get_posts({ post_type: 'case-study', post__in: block.items , orderby: 'post__in', posts_per_page: -1 }) %}

			{%- if block.content.title -%}
				<meta itemprop="name" content="{{ block.content.title }}" />
			{%- endif -%}
			<meta itemprop="numberOfItems" content="{{ total }}" />

			<div class="space-y-14">
				{%- if posts[0] -%}
					<div
						itemprop="itemListElement"
						itemscope
						itemtype="https://schema.org/ListItem"
					>
						<meta itemprop="position" content="1" />
						{{-
							include(
								'components/tease-case-study-card.html.twig',
								{
									post: posts[0],
									sizes: '(min-width: 64rem) 80vw, 100vw'
								},
								with_context: false
							)
						-}}
					</div>
				{%- endif -%}

			
				<ul class="grid grid-cols-1 gap-y-8 lg:grid-cols-3 lg:gap-x-6">
					{%- for item in posts[1:] -%}
						<li
							itemprop="itemListElement"
							itemscope
							itemtype="https://schema.org/ListItem"
						>
							<meta itemprop="position" content="{{ loop.index + (featured ? 1 : 0) }}" />
							{{-
								include(
									'components/tease-case-study-card.html.twig',
									{
										post: item,
										sizes: '(min-width: 64rem) 25vw, 100vw'
									},
									with_context: false
								)
							-}}
						</li>
					{%- endfor -%}
				</ul>
				
			</div>
		{%- endif -%}
	</div>
</section>
