{#
 # Blocks: Call to action
 #}

<section
	id="{{ block.id }}"
	class="border-cream-soft bg-black pt-31.5 pb-39 text-cream border-t lg:pt-42 lg:pb-52"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
>
	<div class="container flex flex-col items-center">
		<div class="flex w-full max-w-225 flex-col items-center space-y-14 text-center">
			{%- if block.content.title or block.content.text -%}
				<header class="flex flex-col items-center space-y-6">
					{%- if block.content.title -%}
						<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xxl text-balance">
							{{- block.content.title -}}
						</{{ block.content.heading | default('h2') }}>
					{%- endif -%}

					{%- if block.content.text -%}
						<p class="text-taupe text-lg max-w-140">
							{{- block.content.text | raw -}}
						</p>
					{%- endif -%}
				</header>
			{%- endif -%}

			{{-
				include(
					'components/button.html.twig',
					block.content.link | default({}) | merge({ variant: 'primary' }),
					with_context = false
				)
			-}}
		</div>
	</div>
</section>
