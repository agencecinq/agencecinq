{#
 # Blocks: Latest Posts
 # Three latest articles in columns capped with a node rule.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

<section
	id="{{ block.id }}"
	class="bg-black text-cream"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
>
	<div class="container space-y-18">
		{%- if block.content.overline or block.content.title -%}
			<header class="space-y-6">
				{{-
					include(
						'components/eyebrow.html.twig',
						{
							title: block.content.overline
						},
						with_context: false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-180">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}
			</header>
		{%- endif -%}

		
		<ul
			class="grid grid-cols-1 gap-y-10 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-14"
			itemscope
			itemtype="https://schema.org/ItemList"
		>
			{%- if block.content.title -%}
				<meta itemprop="name" content="{{ block.content.title }}" />
			{%- endif -%}
			<meta itemprop="numberOfItems" content="{{ posts | length }}" />

			{%- for post in get_posts({ category__in: block.content.category, post_type: 'post', posts_per_page: 3 })  -%}
				<li
					itemprop="itemListElement"
					itemscope
					itemtype="https://schema.org/ListItem"
				>
					<meta itemprop="position" content="{{ loop.index }}" />
					{{-
						include(
							'components/tease-post-column.html.twig',
							{
								post: post
							},
							with_context: false
						)
					-}}
				</li>
			{%- else -%}
				<li>
					<p>{{- __('No posts found', 'agencecinq') -}}</p>
				</li>
			
			{%- endfor -%}
		</ul>
		
	</div>
</section>
