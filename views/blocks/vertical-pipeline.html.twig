{#
 # Blocks: Vertical Pipeline
 # Signature pattern: spine + giant numbers. Eyebrow, title, then numbered steps.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id,
		}
	)
-}}

{%- set steps = block.steps | default( [] ) | filter( step => step.title or step.text ) -%}
{%- set total = '%02d' | format( steps | length ) -%}

<section
	id="{{ block.id }}"
	class="bg-elevated relative overflow-hidden"
	{{ html_attr( block.content.title ? { 'aria-labelledby': block.id ~ '-title' } ) }}
>
	<div class="pointer-events-none absolute inset-x-0 top-0 mx-auto max-w-360" aria-hidden="true">
		<div class="absolute top-40 -right-35 opacity-[0.04]">
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'mark',
						classes: [ 'fill-(--text-color-primary) h-70 w-125' ],
					},
					with_context: false
				)
			-}}
		</div>
	</div>

	<div class="relative container space-y-34">
		{%- if block.content.overline or block.content.title -%}
			<header class="space-y-6">
				{{-
					include(
						'components/eyebrow.html.twig',
						{ title: block.content.overline },
						with_context: false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default( 'h2' ) }}
						id="{{ block.id }}-title"
						class="text-title-xxl max-w-200"
					>
						{{- block.content.title -}}
					</{{ block.content.heading | default( 'h2' ) }}>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if steps | length -%}
			<cinq-vertical-pipeline
				class="after:bg-accent-default relative block before:pointer-events-none before:absolute before:inset-y-0 before:inset-s-0 before:z-1 before:my-13.25 before:ms-[0.40625rem] before:w-0.5 before:bg-(--border-color-default) after:pointer-events-none after:absolute after:inset-y-0 after:inset-s-0 after:z-1 after:my-13.25 after:ms-[0.40625rem] after:w-0.5 after:origin-top after:scale-y-(--progress) after:transition-transform after:duration-300 after:ease-linear before:lg:my-22.75 before:lg:ms-7.5 after:lg:my-22.75 after:lg:ms-7.5"
				style="--progress: 0"
				itemscope
				itemtype="https://schema.org/ItemList"
			>
				<meta itemprop="numberOfItems" content="{{ steps | length }}" />
				{%- if block.content.title -%}
					<meta itemprop="name" content="{{ block.content.title }}" />
				{%- endif -%}

				<ol>
					{%- for step in steps -%}
						<li
							data-dom="item"
							class="[&.is-active]:before:bg-accent-default relative z-2 flex flex-col gap-3 py-8 before:absolute before:inset-y-0 before:inset-s-0 before:mt-11.5 before:size-3.75 before:rounded-full before:bg-(--text-color-subtle) before:ring-4 before:ring-(--background-color-default) before:transition-colors before:duration-300 lg:flex-row lg:items-start lg:gap-14 lg:px-20 lg:py-10 before:lg:ms-[1.46875rem] before:lg:mt-[5.21875rem]"
							itemprop="itemListElement"
							itemscope
							itemtype="https://schema.org/ListItem"
						>
							<meta itemprop="position" content="{{ loop.index }}" />

							<div class="relative flex items-end gap-1 pl-8 lg:w-50 lg:shrink-0 lg:pl-0">
								<span class="text-number-lg lg:text-number-xl" aria-hidden="true">
									{{- '%02d' | format( loop.index ) -}}
								</span>
								<span class="text-subtle text-sm" aria-hidden="true">/{{- total -}}</span>
							</div>

							<div class="flex flex-col gap-3 pl-8 lg:min-w-px lg:flex-1 lg:pt-6 lg:pl-0">
								{%- if step.title -%}
									<h3 class="text-title-lg" itemprop="name">{{- step.title -}}</h3>
								{%- endif -%}
								{%- if step.text -%}
									<p class="text-muted text-sm" itemprop="description">{{- step.text | raw -}}</p>
								{%- endif -%}
							</div>
						</li>
					{%- endfor -%}
				</ol>
			</cinq-vertical-pipeline>
		{%- endif -%}
	</div>
</section>
