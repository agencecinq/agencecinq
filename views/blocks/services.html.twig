{#
 # Blocks: Services
 # Bus-system pattern: eyebrow, title, up to three service columns, optional info frame.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

{%- set items = block.items | default([]) | filter(item => item.title or item.text or item.link.url) -%}
{%- set note = block.note | default({}) -%}

<section
	id="{{ block.id }}"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
>
	<div class="container space-y-18">
		{%- if block.content.overline or block.content.title or block.content.text -%}
			<header class="space-y-6">
				{{-
					include(
						'components/eyebrow.html.twig',
						{
							title: block.content.overline
						},
						with_context = false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-180">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-lg text-taupe max-w-175">
						{{- block.content.text | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length or note.icon or note.label or note.text or note.aside_icon or note.aside or note.aside_code -%}
			<div class="space-y-10">
				{%- if items | length -%}
					<ul
						class="layout-grid gap-y-14"
						itemscope
						itemtype="https://schema.org/ItemList"
					>
						{%- if block.content.title -%}
							<meta itemprop="name" content="{{ block.content.title }}" />
						{%- endif -%}
						<meta itemprop="numberOfItems" content="{{ items | length }}" />

						{%- for item in items -%}
							<li
								class="col-span-full lg:col-span-4"
								itemprop="itemListElement"
								itemscope
								itemtype="https://schema.org/ListItem"
							>
								<meta itemprop="position" content="{{ loop.index }}" />
								{{-
									include(
										'components/tease-service.html.twig',
										{
											title: item.title,
											text: item.text,
											link: item.link,
											index: '%02d/%02d' | format(loop.index, items | length),
											heading: 'h3'
										},
										with_context = false
									)
								-}}
							</li>
						{%- endfor -%}
					</ul>
				{%- endif -%}

				{{-
					include(
						'components/info-frame.html.twig',
						{
							icon: note.icon,
							label: note.label,
							text: note.text,
							aside_icon: note.aside_icon,
							aside: note.aside,
							aside_code: note.aside_code
						},
						with_context = false
					)
				-}}
			</div>
		{%- endif -%}
	</div>
</section>
