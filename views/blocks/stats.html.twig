{#
 # Blocks: Stats
 # Four-column figures band, each column capped with a node rule.
 #}

{%- set items = block.content.items | default([]) | filter(item => item.title or item.text) -%}

{%- if items | length -%}
	{{-
		include(
			'blocks/_layout.html.twig',
			{
				paddings: block.layout.paddings,
				id: block.id
			}
		)
	-}}

	<div
		id="{{ block.id }}"
		class="bg-dark-gray text-cream"
		itemscope
		itemtype="https://schema.org/ItemList"
	>
		<meta itemprop="numberOfItems" content="{{ items | length }}" />

		<div class="container">
			<ul class="layout-grid gap-y-14">
				{%- for item in items -%}
					<li
						class="col-span-full md:col-span-6 lg:col-span-3"
						itemprop="itemListElement"
						itemscope
						itemtype="https://schema.org/ListItem"
					>
						<meta itemprop="position" content="{{ loop.index }}" />
						{{-
							include(
								'components/tease-stat.html.twig',
								{
									title: item.title,
									text: item.text
								},
								with_context = false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</div>
{%- endif -%}
