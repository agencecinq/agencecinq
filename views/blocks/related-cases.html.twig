{#
 # Blocks: Related Cases
 # Two or three related case studies at the end of a case study.
 #}

{%- set items = block.items | default([]) | filter(item => item.case_study) -%}

{%- if items | length -%}
	{{-
		include(
			'blocks/_layout.html.twig',
			{
				paddings: block.layout.paddings,
				id: block.id
			}
		)
	-}}

	{%- set item_span = items | length == 2 ? 'col-span-full md:col-span-6' : 'col-span-full lg:col-span-4' -%}

	<section
		id="{{ block.id }}"
		class="bg-dark-gray"
		{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
		itemscope
		itemtype="https://schema.org/ItemList"
	>
		<div class="container space-y-10">
			{%- if block.content.title -%}
				<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-lg" itemprop="name">
					{{- block.content.title -}}
				</{{ block.content.heading | default('h2') }}>
			{%- endif -%}

			<meta itemprop="numberOfItems" content="{{ items | length }}" />

			<ul class="layout-grid gap-y-6">
				{%- for item in items -%}
					{%- set case = get_post(item.case_study) -%}

					{%- if case -%}
						<li
							class="{{ item_span }}"
							itemprop="itemListElement"
							itemscope
							itemtype="https://schema.org/ListItem"
						>
							<meta itemprop="position" content="{{ loop.index }}" />
							{{-
								include(
									'components/tease-related-case.html.twig',
									{
										post: case,
										text: item.text
									},
									with_context: false
								)
							-}}
						</li>
					{%- endif -%}
				{%- endfor -%}
			</ul>
		</div>
	</section>
{%- endif -%}
