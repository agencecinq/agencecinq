{#
 # Blocks: Crosslinks
 # End-of-page internal links to sibling pages.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id
		}
	)
-}}

{%- set items = block.items | default([]) | filter(item => item.link.url and item.link.title) -%}

<nav
	id="{{ block.id }}"
	class="bg-dark-gray"
	aria-label="{{ block.content.overline | default(__('Related links', 'agencecinq')) }}"
>
	<div class="container space-y-10">
		{{-
			include(
				'components/eyebrow.html.twig',
				{
					title: block.content.overline
				},
				with_context = false
			)
		-}}

		{%- if items | length -%}
			<ul class="layout-grid gap-y-6">
				{%- for item in items -%}
					<li
						class="col-span-full md:col-span-6 lg:col-span-3"
						itemscope
						itemtype="https://schema.org/SiteNavigationElement"
					>
						{{-
							include(
								'components/tease-crosslink.html.twig',
								{
									title: item.link.title,
									url: item.link.url,
									target: item.link.target,
									text: item.text
								},
								with_context = false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</nav>
