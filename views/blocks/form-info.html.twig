{#
 # Blocks: Form + Info
 # Contact page: CF7 form on the left, coordinates on the right with node rules.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id,
		}
	)
-}}

{%- set info = block.info | default( {} ) -%}
{%- set contact = theme.contact | default( {} ) -%}
{%- set locations = contact.locations | default( [] ) | filter( location => location.title ) -%}
{%- set node_rule =
	'relative space-y-3.5 pt-8 before:absolute before:top-1.5 before:right-0 before:left-1.5 before:h-px before:bg-(--border-color-default)  after:absolute after:top-1.5 after:left-0 after:size-2.75 after:-translate-y-1/2 after:rounded-full after:bg-(--text-color-primary) after:ring-4 after:ring-(--background-color-default) '
-%}

<section
	id="{{ block.id }}"
	data-scheme="{{ block.layout.color_scheme | default( '' ) }}"
	class="block-form"
	aria-label="{{ __( 'Contact', 'agencecinq' ) }}"
	itemscope
	itemtype="https://schema.org/ContactPage"
>
	<div class="layout-grid container gap-y-16">
		<div class="col-span-full space-y-5 lg:col-span-8">
			{{-
				include(
					'components/form-contact.html.twig',
					{ form_id: block.content.form | default( null ) },
					with_context: false
				)
			-}}

			{%- if block.content.notice -%}
				<p class="text-subtle">{{- block.content.notice -}}</p>
			{%- endif -%}
		</div>

		{%- if ( locations | length ) or contact.email or contact.phone -%}
			<aside
				class="col-span-full space-y-12 lg:col-span-3 lg:col-start-10"
				itemscope
				itemtype="https://schema.org/Organization"
				itemprop="mainEntity"
			>
				{%- if locations | length -%}
					<div class="{{ node_rule }}">
						{%- if info.locations_overline -%}
							<p class="text-eyebrow text-subtle">{{- info.locations_overline -}}</p>
						{%- endif -%}

						<ul class="space-y-2">
							{%- for location in locations -%}
								<li
									class="text-muted text-base"
									itemprop="location"
									itemscope
									itemtype="https://schema.org/Place"
								>
									<span itemprop="name">{{- location.title -}}</span>
								</li>
							{%- endfor -%}
						</ul>
					</div>
				{%- endif -%}

				{%- if contact.email or contact.phone -%}
					<div class="{{ node_rule }}">
						{%- if info.contact_overline -%}
							<p class="text-eyebrow text-subtle">{{- info.contact_overline -}}</p>
						{%- endif -%}

						<div class="space-y-2">
							{%- if contact.email -%}
								<p>
									<a
										href="mailto:{{ contact.email }}"
										class="text-title-md text-primary hover:text-accent-default"
										itemprop="email"
									>
										{{- contact.email -}}
									</a>
								</p>
							{%- endif -%}

							{%- if contact.phone -%}
								<p class="text-title-md text-primary">
									<a
										href="tel:{{ contact.phone | tel }}"
										class="hover:text-accent-default"
										itemprop="telephone"
									>
										{{- contact.phone -}}
									</a>
									{%- if contact.phone_note -%}
										{{- ', ' ~ contact.phone_note -}}
									{%- endif -%}
								</p>
							{%- endif -%}
						</div>
					</div>
				{%- endif -%}
			</aside>
		{%- endif -%}
	</div>
</section>
