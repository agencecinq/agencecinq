{#
 # Blocks
 #
 # This template can be embedded with Twig embed function like this:
 # {% embed 'blocks/blocks.html.twig' with { blocks: post.meta('blocks') } %}
 #     {% block prepend %}...{% endblock %}
 #     {% block body %}...{% endblock %}
 #     {% block append %}...{% endblock %}
 # {% endembed %}
 #
 # Each block goes through blocks/block.html.twig. The container carries
 # `data-field="blocks"`, the name of the field it renders. In CINQ WP Editor's
 # preview (`cinq_wp_editor`), the stack is rendered even with no block, so a
 # first one can be added.
 #
 # @package AgenceCinq
 # @author CINQ <contact@agencecinq.com> (https://agencecinq.com)
 #}

{%- set editor = cinq_wp_editor | default( false ) -%}

{%- if blocks or editor -%}
	<div class="{{ html_classes( classes | default( [] ) | join( ' ' ) ) | trim }}" data-field="blocks">
		{%- block prepend -%}{%- endblock -%}

		{%- block body -%}
			{%- for block in blocks | default( [] ) -%}
				{{-
					include(
						'blocks/block.html.twig',
						{
							block: block,
							loop: loop.index0,
						}
					)
				-}}
			{%- endfor -%}
		{%- endblock -%}

		{%- block append -%}{%- endblock -%}
	</div>
{%- endif -%}
