	{% set contrast_ratios = [
		{
			pair: 'text/cream on bg/black',
			ratio: '17.45:1',
			fails: false
		},
		{
			pair: 'pistachio on bg/black',
			ratio: '16.49:1',
			fails: false
		},
		{
			pair: 'text/off-black on pistachio',
			ratio: '16.24:1',
			fails: false
		},
		{
			pair: 'text/taupe on bg/black',
			ratio: '6.88:1',
			fails: false
		},
		{
			pair: 'text/taupe on bg/gray',
			ratio: '6.64:1',
			fails: false
		},
		{
			pair: 'text/stone on bg/black',
			ratio: '4.75:1',
			fails: false
		},
		{
			pair: 'text/stone on bg/dark-gray',
			ratio: '4.59:1',
			fails: false
		},
		{
			pair: 'text/stone on bg/gray',
			ratio: '4.34:1 — below AA threshold',
			fails: true
		}
	] %}

	<section class="bg-black text-cream my-8 flex flex-col gap-14 p-5 lg:p-20">
		<header class="flex max-w-180 flex-col gap-3">
			<p class="text-eyebrow text-taupe">
				● Foundations
			</p>
			<h2 class="text-title-xl">Colors</h2>
			<p class="text-taupe text-sm">
				Single-theme site (dark). Depth comes from stacked blacks and grays, not extra hues.
				Pistachio is the sole chromatic color, used sparingly: CTAs, nodes, active links, focus.
			</p>
		</header>

		{% for group in color_groups %}
			<div class="flex flex-col gap-6">
				<p class="text-eyebrow text-taupe">
					{{ group.label }}
				</p>
				<div class="{{ html_classes('grid grid-cols-1 gap-6 sm:grid-cols-2', group.columns) }}">
					{% for swatch in group.swatches %}
						<div class="flex flex-col gap-3">
							<div
								class="{{ html_classes('border-cream-soft h-33 rounded-lg border', swatch.bg) }}"
							></div>
							<div class="flex flex-col gap-1">
								<p class="text-title-md">
									{{ swatch.name }}
								</p>
								<p class="text-label text-pistachio">
									--color-{{ swatch.token }}
								</p>
								<p class="text-taupe text-sm">
									{{ swatch.description }}
								</p>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endfor %}

		<div class="border-pistachio flex flex-col gap-3.5 border-l-2 pl-6">
			<p class="text-title-md">
				text/stone must not be used on bg/gray
			</p>
			<p class="text-taupe max-w-225 text-sm">
				On bg/black it scores 4.75:1, just above the AA threshold. On bg/gray (#141614) it drops to
				4.34:1 and falls below. On a card, the secondary text level is therefore text/taupe (6.6:1).
				Applies to form placeholders, crosslink subtitles, and card details.
			</p>
		</div>

		<div class="flex flex-col gap-2">
			<p class="text-label text-stone">
				Measured Ratios
			</p>
			{% for item in contrast_ratios %}
				<div class="flex flex-col gap-1 sm:flex-row sm:gap-6">
					<p class="text-taupe w-full text-sm sm:w-90">
						{{ item.pair }}
					</p>
					<p class="{{ html_classes('text-label', item.fails ? 'text-cream' : 'text-pistachio') }}">
						{{ item.ratio }}
					</p>
				</div>
			{% endfor %}
		</div>
	</section>

