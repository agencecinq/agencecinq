	<section class="bg-black text-cream my-8 flex flex-col gap-16 p-5 lg:p-20">
		<header class="flex max-w-215 flex-col gap-3">
			<p class="text-eyebrow text-taupe">
				Fondations
			</p>
			<h2 class="text-title-xl">Typographie</h2>
			<p class="text-taupe text-sm">
				Deux familles Google Fonts. Inter porte les titres et le texte courant ; JetBrains Mono
				porte tout le méta : surtitres, index, libellés de bouton, badges. Titres et textes passent
				en version desktop dès 1024 px ; le méta ne change pas.
			</p>
		</header>

		{% for group in type_groups %}
			<div>
				<p class="text-eyebrow text-taupe">
					{{ group.label }}
				</p>
				{% for style in group.styles %}
					<div class="border-cream-faint flex flex-col gap-6 border-t py-6 lg:flex-row lg:gap-10">
						<div class="flex w-full shrink-0 flex-col gap-1.5 whitespace-nowrap lg:w-55">
							<p class="text-title-md">
								{{ style.name }}
							</p>
							<p class="text-label text-stone">
								{{ style.specs }}
							</p>
							{%- if style.mobile_specs -%}
								<p class="text-label text-stone">
									{{ style.mobile_specs }}
								</p>
							{%- endif -%}
							<code class="text-label text-stone">.{{ style.class }}</code>
						</div>
						<div class="flex min-w-0 flex-1 flex-col gap-4 overflow-x-auto">
							<p class="{{ style.desktop_class }}">
								{{ style.sample }}
							</p>
							{%- if style.mobile_class -%}
								<p class="{{ style.mobile_class }}">
									{{ style.sample }}
								</p>
							{%- endif -%}
						</div>
					</div>
				{% endfor %}
			</div>
		{% endfor %}
	</section>
</div>
