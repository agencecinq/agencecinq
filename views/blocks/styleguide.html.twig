	{% set color_groups = [
		{
			label: 'Backgrounds',
			columns: 'lg:grid-cols-4',
			swatches: [
				{
					name: 'Page',
					token: 'page',
					bg: 'bg-page',
					description: 'Site-wide background. #08090A'
				},
				{
					name: 'Elevated',
					token: 'elevated',
					bg: 'bg-elevated',
					description: 'Footer, banners, detached sections. #0D0F0E'
				},
				{
					name: 'Card',
					token: 'card',
					bg: 'bg-card',
					description: 'Cards, panels, form fields. #141614'
				},
				{
					name: 'Card · hover',
					token: 'card-hover',
					bg: 'bg-card-hover',
					description: 'Hovered state of a clickable card. #1C201C'
				}
			]
		},
		{
			label: 'Texts',
			columns: 'lg:grid-cols-4',
			swatches: [
				{
					name: 'Primary',
					token: 'primary',
					bg: 'bg-primary',
					description: 'Headings and body text. #F1F0EA'
				},
				{
					name: 'Muted',
					token: 'muted',
					bg: 'bg-muted',
					description: 'Lead text, descriptions. 5.8:1 — AA. #9A988D'
				},
				{
					name: 'Subtle',
					token: 'subtle',
					bg: 'bg-subtle',
					description: 'Indices, mentions, labels. 4.8:1 — AA. #7E7C71'
				},
				{
					name: 'On accent',
					token: 'on-accent',
					bg: 'bg-on-accent',
					description: 'Text on green accent. #0A0C0A'
				}
			]
		},
		{
			label: 'Accent & Borders',
			columns: 'lg:grid-cols-5',
			swatches: [
				{
					name: 'Accent',
					token: 'accent',
					bg: 'bg-accent',
					description: 'CTAs, nodes, focus, active links. #B3FCA4'
				},
				{
					name: 'Accent · hover',
					token: 'accent-hover',
					bg: 'bg-accent-hover',
					description: 'Primary CTA hover. #C7FFBB'
				},
				{
					name: 'Accent soft',
					token: 'accent-soft',
					bg: 'bg-accent-soft',
					description: '14% tinted background. Badges, highlights.'
				},
				{
					name: 'Border',
					token: 'border',
					bg: 'bg-border',
					description: 'Rules, dividers. Cream at 11%.'
				},
				{
					name: 'Border subtle',
					token: 'border-subtle',
					bg: 'bg-border-subtle',
					description: 'Inner dividers. Cream at 6%.'
				}
			]
		}
	] %}

	{% set contrast_ratios = [
		{
			pair: 'text/primary on bg/page',
			ratio: '17.45:1',
			fails: false
		},
		{
			pair: 'accent on bg/page',
			ratio: '16.49:1',
			fails: false
		},
		{
			pair: 'text/on-accent on accent',
			ratio: '16.24:1',
			fails: false
		},
		{
			pair: 'text/muted on bg/page',
			ratio: '6.88:1',
			fails: false
		},
		{
			pair: 'text/muted on bg/card',
			ratio: '6.64:1',
			fails: false
		},
		{
			pair: 'text/subtle on bg/page',
			ratio: '4.75:1',
			fails: false
		},
		{
			pair: 'text/subtle on bg/elevated',
			ratio: '4.59:1',
			fails: false
		},
		{
			pair: 'text/subtle on bg/card',
			ratio: '4.34:1 — below AA threshold',
			fails: true
		}
	] %}

	<section class="bg-page text-primary my-8 flex flex-col gap-14 p-5 lg:p-20">
		<header class="flex max-w-180 flex-col gap-3">
			<p class="text-eyebrow text-muted">
				● Foundations
			</p>
			<h2 class="text-title-xl">Colors</h2>
			<p class="text-muted text-sm">
				Single-theme site (dark). Depth comes from four stacked blacks, not color. Pistachio green
				is the sole accent, used sparingly: CTAs, nodes, active links, focus.
			</p>
		</header>

		{% for group in color_groups %}
			<div class="flex flex-col gap-6">
				<p class="text-eyebrow text-muted">
					{{ group.label }}
				</p>
				<div class="{{ html_classes('grid grid-cols-1 gap-6 sm:grid-cols-2', group.columns) }}">
					{% for swatch in group.swatches %}
						<div class="flex flex-col gap-3">
							<div
								class="{{ html_classes('border-border h-33 rounded-lg border', swatch.bg) }}"
							></div>
							<div class="flex flex-col gap-1">
								<p class="text-title-md">
									{{ swatch.name }}
								</p>
								<p class="text-label text-accent">
									--color-{{ swatch.token }}
								</p>
								<p class="text-muted text-sm">
									{{ swatch.description }}
								</p>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endfor %}

		<div class="border-border-accent flex flex-col gap-3.5 border-l-2 pl-6">
			<p class="text-title-md">
				text/subtle must not be used on bg/card
			</p>
			<p class="text-muted max-w-225 text-sm">
				On bg/page it scores 4.75:1, just above the AA threshold. On bg/card (#141614) it drops to
				4.34:1 and falls below. On a card, the secondary text level is therefore text/muted (6.6:1).
				Applies to form placeholders, crosslink subtitles, and card details.
			</p>
		</div>

		<div class="flex flex-col gap-2">
			<p class="text-label text-subtle">
				Measured Ratios
			</p>
			{% for item in contrast_ratios %}
				<div class="flex flex-col gap-1 sm:flex-row sm:gap-6">
					<p class="text-muted w-full text-sm sm:w-90">
						{{ item.pair }}
					</p>
					<p class="{{ html_classes('text-label', item.fails ? 'text-primary' : 'text-accent') }}">
						{{ item.ratio }}
					</p>
				</div>
			{% endfor %}
		</div>
	</section>

