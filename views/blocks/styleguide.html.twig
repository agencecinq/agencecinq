<div class="container py-10 lg:py-20">
	<div class="overflow-x-auto">
		<table class="bg-card/40 my-8 w-full border-collapse text-left">
			<thead class="uppercase">
				<tr>
					<th class="p-4">Name</th>
					<th class="p-4">Type</th>
					<th class="p-4">Default</th>
					<th class="p-4">Description</th>
				</tr>
			</thead>
			<tbody class="divide-y">
				<tr>
					<td class="p-4"><code>variant</code></td>
					<td class="p-4"><code>string</code></td>
					<td class="p-4"><code>'primary'</code></td>
					<td class="p-4">
						Variant of the button. Can be
						<code>'primary'</code>,
						<code>'secondary'</code>,
						<code>'tertiary'</code>
						or
						<code>'quaternary'</code>.
					</td>
				</tr>
				<tr>
					<td class="p-4"><code>disabled</code></td>
					<td class="p-4"><code>bool</code></td>
					<td class="p-4"><code>false</code></td>
					<td class="p-4">Whether the button is disabled.</td>
				</tr>
				<tr>
					<td class="p-4"><code>icon</code></td>
					<td class="p-4"><code>string</code></td>
					<td class="p-4"><code>null</code></td>
					<td class="p-4">The name of the icon to display.</td>
				</tr>
				<tr>
					<td class="p-4"><code>fill</code></td>
					<td class="p-4"><code>string</code></td>
					<td class="p-4"><code>null</code></td>
					<td class="p-4">
						Color of the icon. Can be
						<code>'text-accent'</code>,
						<code>'text-primary'</code>
						or
						<code>'text-on-accent'</code>.
					</td>
				</tr>
				<tr>
					<td class="p-4"><code>mode</code></td>
					<td class="p-4"><code>string</code></td>
					<td class="p-4"><code>'light'</code></td>
					<td class="p-4">
						Color mode of the button. Can be
						<code>'light'</code>
						or
						<code>'dark'</code>.
					</td>
				</tr>
				<tr>
					<td class="p-4"><code>title</code></td>
					<td class="p-4"><code>string</code></td>
					<td class="p-4"></td>
					<td class="p-4">The button text.</td>
				</tr>
				<tr>
					<td class="p-4"><code>attributes</code></td>
					<td class="p-4"><code>array</code></td>
					<td class="p-4"><code>{}</code></td>
					<td class="p-4">Additional HTML attributes for the button element.</td>
				</tr>
				<tr>
					<td class="p-4"><code>classes</code></td>
					<td class="p-4"><code>array</code></td>
					<td class="p-4"><code>[]</code></td>
					<td class="p-4">Additional CSS classes for the button element.</td>
				</tr>
				<tr>
					<td class="p-4"><code>animate</code></td>
					<td class="p-4"><code>bool</code></td>
					<td class="p-4"><code>true</code></td>
					<td class="p-4">
						Whether to animate the icon on hover (only for icons with animation, like the 'bullet'
						or 'arrow-right').
					</td>
				</tr>
			</tbody>
		</table>
	</div>

