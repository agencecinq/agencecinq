{#
 # Blocks: FAQ
 # Accordion of questions. First item open by default. FAQPage microdata.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

{%- set items = block.items | default([]) | filter(item => item.question and item.answer | striptags | trim) -%}

<section
	id="{{ block.id }}"
	class="bg-black text-cream"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
	itemscope
	itemtype="https://schema.org/FAQPage"
>
	<div class="container layout-grid gap-y-14">
		{%- if block.content.overline or block.content.title -%}
			<header class="col-span-full space-y-6 lg:col-span-8">
				{{-
					include(
						'components/eyebrow.html.twig',
						{
							title: block.content.overline
						},
						with_context: false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-180">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length -%}
			<cinq-accordion-group class="col-span-full block lg:col-span-8">
				{%- for item in items -%}
					{%- set question_id = block.id ~ '-question-' ~ loop.index -%}
					{%- set answer_id = block.id ~ '-answer-' ~ loop.index -%}

					<div
						class="js-accordion-panel border-cream-soft border-b py-6"
						data-accordion-open="{{ loop.first ? 'true' : 'false' }}"
						data-accordion-deselect="true"
						itemscope
						itemprop="mainEntity"
						itemtype="https://schema.org/Question"
					>
						<button
							type="button"
							class="js-accordion-header group text-title-md flex w-full cursor-pointer items-center gap-6 text-left text-cream aria-expanded:text-pistachio"
							aria-expanded="{{ loop.first ? 'true' : 'false' }}"
							aria-controls="{{ answer_id }}"
							id="{{ question_id }}"
						>
							{%- if item.question -%}
								<span class="min-w-0 flex-1" itemprop="name">
									{{- item.question -}}
								</span>
							{%- endif -%}

							<span class="text-stone shrink-0 group-aria-expanded:hidden" aria-hidden="true">+</span>
							<span class="hidden shrink-0 group-aria-expanded:inline" aria-hidden="true">−</span>
						</button>

						<div
							class="transition-[max-height] duration-300 ease-out"
							id="{{ answer_id }}"
							role="region"
							aria-labelledby="{{ question_id }}"
							itemscope
							itemprop="acceptedAnswer"
							itemtype="https://schema.org/Answer"
						>
							<div class="js-accordion-inner wysiwyg text-taupe pt-4 [&_a]:text-pistachio" itemprop="text">
								{{- item.answer | raw -}}
							</div>
						</div>
					</div>
				{%- endfor -%}
			</cinq-accordion-group>
		{%- endif -%}
	</div>
</section>
