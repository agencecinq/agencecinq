{#
 # Blocks: Editorial Cards
 # Section intro + open editorial card grid.
 #}

{{- include( 'blocks/_layout.html.twig', { paddings: block.layout.paddings, id: block.id } ) -}}

{%- set cards = block.cards | default([]) | filter(card => card.title or card.text or card.figure or card.flow_input or card.flow_output) -%}

<section
	id="{{ block.id }}"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
>
	<div class="container space-y-18">
		{%- if block.content.overline or block.content.title or block.content.text -%}
			<header class="space-y-4.5">
				{{-
					include(
						'components/eyebrow.html.twig',
						{ title: block.content.overline },
						with_context = false
					)
				-}}

				{%- if block.content.title -%}
					<{{ block.content.heading | default('h2') }} id="{{ block.id }}-title" class="text-title-xl max-w-none">
						{{- block.content.title -}}
					</{{ block.content.heading | default('h2') }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-lg text-taupe max-w-175">
						{{- block.content.text | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if cards | length -%}
			{%- set card_span = cards | length == 1 ? 'lg:col-span-8' : ( cards | length == 2 ? 'md:col-span-6' : 'md:col-span-6 xl:col-span-4' ) -%}
			<ul
				class="layout-grid gap-y-6"
				itemscope
				itemtype="https://schema.org/ItemList"
			>
				{%- if block.content.title -%}
					<meta itemprop="name" content="{{ block.content.title }}" />
				{%- endif -%}
				<meta itemprop="numberOfItems" content="{{ cards | length }}" />

				{%- for card in cards -%}
					<li
						class="col-span-full {{ card_span }}"
						itemprop="itemListElement"
						itemscope
						itemtype="https://schema.org/ListItem"
					>
						<meta itemprop="position" content="{{ loop.index }}" />
						{{-
							include(
								'components/tease-editorial-card.html.twig',
								{
									overline: card.overline,
									title: card.title,
									figure: card.figure,
									flow_input: card.flow_input,
									flow_output: card.flow_output,
									text: card.text,
									heading: 'h3'
								},
								with_context = false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>
