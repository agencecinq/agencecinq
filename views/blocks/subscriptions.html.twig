{#
 # Blocks: Subscriptions
 # Title, intro, then up to two subscription plan cards.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id,
		}
	)
-}}

{%- set catalogue = catalogue() -%}
{%- set day_rate = catalogue and catalogue.ad_hoc_day_rate()
	? catalogue.amount_excl_vat( catalogue.ad_hoc_day_rate() )
	: ''
-%}

{#- A plan linked to a platform takes its tiers and monthly prices from Central. -#}
{%- set items =
	block.items
		| default( [] )
		| map(
			item => item.platform and catalogue
				? item | merge( {
					title: item.title ?: catalogue.retainers( item.platform ) | first.range | default( '' ),
					prices: catalogue.retainers( item.platform ) | map(
						retainer => {
							text: catalogue.retainer_tier( retainer ) ~ ' · '
								~ catalogue.retainer_price( retainer ),
						}
					),
				} )
				: item
		)
-%}
{%- set items =
	items | filter( item => item.overline or item.title or item.text or item.prices )
-%}

<section
	id="{{ block.id }}"
	class="bg-dark-gray"
	{{ block.content.title ? 'aria-labelledby="' ~ block.id ~ '-title"' }}
>
	<div class="container space-y-14">
		{%- if block.content.title or block.content.text -%}
			<header class="space-y-6">
				{%- if block.content.title -%}
					<{{ block.content.heading | default( 'h2' ) }}
						id="{{ block.id }}-title"
						class="text-title-xl"
					>
						{{- block.content.title -}}
					</{{ block.content.heading | default( 'h2' ) }}>
				{%- endif -%}

				{%- if block.content.text -%}
					<p class="text-taupe max-w-180 text-base">
						{{- block.content.text | replace( { '{day_rate}': day_rate } ) | raw -}}
					</p>
				{%- endif -%}
			</header>
		{%- endif -%}

		{%- if items | length -%}
			<ul class="layout-grid gap-y-8" itemscope itemtype="https://schema.org/ItemList">
				{%- if block.content.title -%}
					<meta itemprop="name" content="{{ block.content.title }}" />
				{%- endif -%}
				<meta itemprop="numberOfItems" content="{{ items | length }}" />

				{%- for item in items -%}
					<li
						class="col-span-full flex lg:col-span-6"
						itemprop="itemListElement"
						itemscope
						itemtype="https://schema.org/ListItem"
					>
						<meta itemprop="position" content="{{ loop.index }}" />
						{{-
							include(
								'components/subscription-plan.html.twig',
								{
									overline: item.overline,
									title: item.title,
									text: item.text,
									prices: item.prices,
									heading: 'h3',
								},
								with_context: false
							)
						-}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</div>
</section>
