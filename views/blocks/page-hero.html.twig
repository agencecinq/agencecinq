{#
 # Blocks: Page Hero
 # Inner-page hero: overline, title, lead, CTAs, optional meta and image.
 #}

{{-
	include(
		'blocks/_layout.html.twig',
		{
			paddings: block.layout.paddings,
			id: block.id
		}
	)
-}}

{{-
	include(
		'components/page-hero.html.twig',
		{
			id: block.id,
			overline: block.content.overline,
			title: block.content.title,
			text: block.content.text,
			links: block.content.links,
			meta: block.content.meta,
			image: block.image,
			heading: block.heading
		},
		with_context = false
	)
-}}
