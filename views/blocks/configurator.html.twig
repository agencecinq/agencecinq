{#
 # Blocks: Configurator
 # The estimator: platform, package, modules, and the estimate. Offers and prices come from Central.
 #
 # Everything is rendered here, server side: every platform, package and module, with its price
 # already formatted. cinq-configurator only shows the modules the chosen package accepts and sums
 # the total. « Receive my estimate » posts the e-mail and the choice to /wp-json/cinq/v1/quote
 # (Catalogue/QuoteRequest.php), then opens the confirmation, which links to the booking page
 # with the choice attached (Plugins/ContactForm7/Estimation.php). Without JavaScript the form
 # is a plain GET to that booking page: each platform has its own package group, socle[platform],
 # and CSS only shows the packages and modules of the checked platform.
 #}

{% macro chip( args = {} ) %}
	{%- set args =
		{
			type: 'radio',
			name: '',
			value: '',
			text: '',
			price: '',
			platform: '',
			attributes: {},
			checked: false,
			disabled: false,
		} | merge( args )
	-%}

	<label
		class="{{
			[
				'border-control bg-surface text-eyebrow text-muted inline-flex cursor-pointer items-center gap-2.5 rounded-full border px-4.5 py-3 transition-colors',
				'hover:text-primary has-checked:border-accent has-checked:bg-accent-soft has-checked:text-primary',
				'has-focus-visible:outline-focus-ring has-focus-visible:outline-2 has-focus-visible:outline-offset-2',
				'has-checked:before:bg-accent-default before:size-1.75 before:shrink-0 before:rounded-full before:bg-(--text-color-subtle)',
				'has-disabled:hidden',
			] | join( ' ' )
		}}"
		{{ html_attr( { 'data-platform': args.platform ?: false } ) }}
	>
		<input
			type="{{ args.type }}"
			name="{{ args.name }}"
			value="{{ args.value }}"
			class="sr-only"
			{{
				html_attr(
					args.attributes,
					{
						checked: args.checked,
						disabled: args.disabled,
					}
				)
			}}
		/>
		<span>
			<span data-dom="name">{{- args.text -}}</span>
			{%- if args.price %}
				· <span data-dom="price">{{- args.price -}}</span>
			{%- endif -%}
		</span>
	</label>
{%- endmacro %}

{%- set catalogue = catalogue() -%}
{%- set platforms = catalogue
	? catalogue.platforms() | filter( item => catalogue.packages( item.id ) | length )
	: []
-%}

{%- if platforms | length -%}
	{{-
		include(
			'blocks/_layout.html.twig',
			{
				paddings: block.layout.paddings,
				id: block.id,
			}
		)
	-}}

	{%- set default_platform = platforms | first -%}
	{%- set platform = block.catalogue.platform in ( platforms | map( item => item.id ) )
		? block.catalogue.platform
		: default_platform.id
	-%}
	{%- set package = catalogue.package( platform, block.catalogue.package | default( '' ) )
		?? ( catalogue.packages( platform ) | first )
	-%}
	{#- The package checked in each platform group: the chosen one, else the first of the platform. -#}
	{%- set defaults = {} -%}
	{%- for item in platforms -%}
		{%- set defaults =
			defaults | merge( {
				( item.id ): item.id == platform ? package : catalogue.packages( item.id ) | first,
			} )
		-%}
	{%- endfor -%}
	{%- set accepted = package.moduleIds | default( [] ) -%}
	{%- set composition = catalogue.compose( platform, package.code, [] ) -%}
	{%- set labels = {
		package: __( 'Package', 'agencecinq' ),
		from: _x( 'From', 'starting price', 'agencecinq' ),
		quote: __( 'On request', 'agencecinq' ),
		error: __( 'The submission failed. Please check your connection and try again.', 'agencecinq' ),
	} -%}

	{# prettier-ignore-start #}
	<style>
		{%- for item in platforms %}
			#{{ block.id }}:has([name="plateforme"][value="{{ item.id }}"]:checked) [data-platform]:not([data-platform="{{ item.id }}"]) {
				display: none;
			}
		{%- endfor %}
	</style>
	{# prettier-ignore-end #}

	<section id="{{ block.id }}" aria-label="{{ block.result.title }}">
		<div class="container">
			<cinq-configurator class="block" data-labels="{{ labels | json_encode | e( 'html_attr' ) }}">
				<form
					method="get"
					action="{{ block.result.page }}"
					class="flex flex-col gap-14 lg:flex-row lg:items-start"
					novalidate
				>
					<div class="min-w-0 flex-1 space-y-12">
						<fieldset class="min-w-0">
							<legend class="float-left w-full">
								<span class="text-eyebrow text-subtle block">
									{{- __( 'Step %02d', 'agencecinq' ) | format( 1 ) -}}
								</span>
								<span class="text-title-md text-primary mt-2.5 block">
									{{- block.steps.platform_title -}}
								</span>
							</legend>

							<div class="clear-left flex flex-wrap gap-3 pt-5">
								{%- for item in platforms -%}
									{{-
										_self.chip( {
											name: 'plateforme',
											value: item.id,
											text: item.label,
											attributes: { 'data-dom': 'platform' },
											checked: item.id == platform,
										} )
									-}}
								{%- endfor -%}
							</div>
						</fieldset>

						<fieldset class="min-w-0">
							<legend class="float-left w-full">
								<span class="text-eyebrow text-subtle block">
									{{- __( 'Step %02d', 'agencecinq' ) | format( 2 ) -}}
								</span>
								<span class="text-title-md text-primary mt-2.5 block">
									{{- block.steps.package_title -}}
								</span>
							</legend>

							{%- if block.steps.package_text -%}
								<p class="text-muted clear-left pt-2 text-sm">{{- block.steps.package_text -}}</p>
							{%- endif -%}

							<div class="clear-left flex flex-wrap gap-3 pt-5">
								{%- for item in catalogue.packages() -%}
									{{-
										_self.chip( {
											name: 'socle[' ~ item.category.id ~ ']',
											value: item.category.id ~ ':' ~ item.code,
											text: item.name,
											price: catalogue.price( item, true ),
											platform: item.category.id,
											attributes: {
												'data-dom': 'package',
												'data-price': item.priceExclVat,
												'data-mode': catalogue.mode( item ),
												'data-modules': item.moduleIds | join( ',' ),
											},
											checked: item.id == ( defaults[ item.category.id ].id | default( '' ) ),
										} )
									-}}
								{%- endfor -%}
							</div>
						</fieldset>

						<fieldset class="min-w-0">
							<legend class="float-left w-full">
								<span class="text-eyebrow text-subtle block">
									{{- __( 'Step %02d', 'agencecinq' ) | format( 3 ) -}}
								</span>
								<span class="text-title-md text-primary mt-2.5 block">
									{{- block.steps.modules_title -}}
								</span>
							</legend>

							{%- if block.steps.modules_text -%}
								<p
									class="text-muted clear-left pt-2 text-sm"
									data-dom="modules-text"
									data-template="{{ block.steps.modules_text | e( 'html_attr' ) }}"
									{{ accepted is empty ? 'hidden' }}
								>
									{{- block.steps.modules_text | replace( { '{package}': package.name } ) -}}
								</p>
							{%- endif -%}

							<p
								class="text-muted clear-left pt-2 text-sm"
								data-dom="modules-empty"
								{{ accepted is not empty ? 'hidden' }}
							>
								{{- block.steps.modules_empty -}}
							</p>

							<div
								class="clear-left flex flex-wrap gap-3 pt-5"
								data-dom="modules"
								{{ accepted is empty ? 'hidden' }}
							>
								{%- for item in catalogue.modules() -%}
									{{-
										_self.chip( {
											type: 'checkbox',
											name: 'modules[]',
											value: item.id,
											text: item.name,
											price: catalogue.price( item, true ),
											platform: item.category.id,
											attributes: {
												'data-dom': 'module',
												'data-price': item.priceExclVat,
												'data-mode': catalogue.mode( item ),
											},
											disabled: item.id
												not in ( defaults[ item.category.id ].moduleIds | default( [] ) ),
										} )
									-}}
								{%- endfor -%}
							</div>
						</fieldset>
					</div>

					<aside
						class="bg-surface border-accent w-full rounded-md border p-8 lg:sticky lg:inset-x-0 lg:top-[calc(var(--header-height)+(--spacing(20)))] lg:w-105 lg:shrink-0"
						aria-labelledby="{{ block.id }}-result"
					>
						<h2 id="{{ block.id }}-result" class="text-eyebrow text-accent-default">
							{{- block.result.title -}}
						</h2>

						<dl class="mt-6" data-dom="lines">
							<div class="border-subtle flex items-center justify-between gap-4 border-t py-3">
								<dt class="text-muted text-sm">{{ labels.package }} {{ package.name }}</dt>
								<dd class="text-primary text-sm whitespace-nowrap">
									{{- catalogue.price( package, true ) -}}
								</dd>
							</div>
						</dl>

						<template data-dom="line">
							<div class="border-subtle flex items-center justify-between gap-4 border-t py-3">
								<dt class="text-muted text-sm"></dt>
								<dd class="text-primary text-sm whitespace-nowrap"></dd>
							</div>
						</template>

						<dl class="border-subtle flex items-center justify-between gap-4 border-t py-3">
							<dt class="text-title-md text-primary">{{- block.result.total_label -}}</dt>
							<dd
								class="text-title-lg text-accent-default text-right"
								data-dom="total"
								aria-live="polite"
							>
								{%- if composition.total.mode == constant( 'QUOTE', catalogue ) -%}
									{{- labels.quote -}}
								{%- elseif composition.total.mode == constant( 'FROM', catalogue ) -%}
									{{- labels.from }} {{ catalogue.amount( composition.total.amount ) -}}
								{% else %}
									{{- catalogue.amount( composition.total.amount ) -}}
								{%- endif -%}
							</dd>
						</dl>

						{%- set mention_classes =
							'text-eyebrow text-muted mt-5 flex items-center gap-2.5 before:size-1.75 before:shrink-0 before:rounded-full'
						-%}

						{%- if block.result.firm_text -%}
							<p
								class="{{ mention_classes }} before:bg-accent-default"
								data-dom="firm"
								{{ composition.total.mode != constant( 'FIRM', catalogue ) ? 'hidden' }}
							>
								{{- block.result.firm_text -}}
							</p>
						{%- endif -%}

						{%- if block.result.open_text -%}
							<p
								class="{{ mention_classes }} before:bg-(--text-color-subtle)"
								data-dom="open"
								{{ composition.total.mode == constant( 'FIRM', catalogue ) ? 'hidden' }}
							>
								{{- block.result.open_text -}}
							</p>
						{%- endif -%}

						{#- The e-mail has no name: without JavaScript the form still goes to the booking page, never with the address in the URL. -#}
						<div class="mt-7 space-y-3">
							{{-
								include(
									'components/input.html.twig',
									{
										id: block.id ~ '-email',
										label: block.result.email_label,
										type: 'email',
										error: block.result.email_error,
										invalid: false,
										attributes: {
											pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}',
											required: true,
											autocomplete: 'email',
											inputmode: 'email',
											placeholder: block.result.email_placeholder,
											'data-dom': 'email',
										},
									},
									with_context: false
								)
							-}}

							{#- Honeypot: hidden from people and assistive technologies, filled by bots. -#}
							<div class="sr-only" aria-hidden="true">
								<input type="text" tabindex="-1" autocomplete="off" data-dom="website" />
							</div>

							{%- if block.result.button_label -%}
								{{-
									include(
										'components/button.html.twig',
										{
											title: block.result.button_label,
											type: 'submit',
											classes: [ 'w-full justify-center lg:w-auto' ],
											attributes: { 'data-dom': 'submit' },
										},
										with_context: false
									)
								-}}
							{%- endif -%}

							<p class="text-status-error text-sm" data-dom="status" role="alert" hidden></p>

							{%- if block.result.privacy -%}
								<p class="text-muted text-sm">
									{{- block.result.privacy -}}
									{%- if privacy_policy_url %}
										<a
											href="{{ privacy_policy_url }}"
											class="text-primary underline underline-offset-2"
										>
											{{ __( 'Privacy policy', 'agencecinq' ) }}
										</a>
									{%- endif -%}
								</p>
							{%- endif -%}
						</div>

						{%- if block.result.notice -%}
							<p class="text-muted mt-5 text-sm">{{- block.result.notice | raw -}}</p>
						{%- endif -%}
					</aside>
				</form>

				{{-
					include(
						'components/modal-quote-sent.html.twig',
						{
							id: block.id ~ '-sent',
							modal: block.modal,
						},
						with_context: false
					)
				-}}
			</cinq-configurator>
		</div>
	</section>
{%- endif -%}
