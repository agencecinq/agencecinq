{#
 # Blocks: Credibility Banner
 # Reassurance strip: three to four short verifiable proofs, separated by rules.
 #}

{%- set items = block.content.items | default( [] ) | filter( item => item.text ) -%}

{%- if items | length -%}
	{{-
		include(
			'blocks/_layout.html.twig',
			{
				paddings: block.layout.paddings,
				id: block.id,
			}
		)
	-}}

	<div id="{{ block.id }}" class="border-default bg-elevated text-muted border-y py-10 text-sm">
		<div class="container">
			<ul
				class="divide-default flex flex-col max-lg:divide-y lg:flex-row lg:items-start lg:divide-x"
			>
				{%- for item in items -%}
					<li
						class="flex min-w-0 flex-1 items-center gap-3 py-4 wrap-break-word before:size-1.75 before:shrink-0 before:rounded-full before:bg-(--text-color-muted) first:pt-0 last:pb-0 lg:px-8 lg:py-0 lg:first:pl-0"
					>
						{{- item.text -}}
					</li>
				{%- endfor -%}
			</ul>
		</div>
	</div>
{%- endif -%}
