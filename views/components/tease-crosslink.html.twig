{#
 # Components: Tease Crosslink
 #
 # Sibling-page card: title with arrow, mono description, whole card is the link.
 #
 # @param string title Visible label and SEO anchor.
 # @param string url
 # @param string target
 # @param string text Short description.
 # @param array classes
 #}

{%- set target = target | default( '' ) -%}

{%- if url and title -%}
	<a
		href="{{ url }}"
		class="{{
			html_classes(
				'border-default bg-surface hover:border-accent group flex h-full flex-col space-y-2 rounded-md border p-6 transition-colors',
				classes | default( [] ) | join( ' ' )
			)
		}}"
		itemprop="url"
		{{ target ? 'target="' ~ target ~ '"' }}
		{{ target == '_blank' ? 'rel="noopener noreferrer"' }}
	>
		<span class="text-title-md text-primary group-hover:text-accent-default transition-colors">
			<span itemprop="name">{{- title -}}</span>
			<span aria-hidden="true">{{ ' →' }}</span>
		</span>

		{%- if text -%}
			<span class="text-muted text-sm">{{- text -}}</span>
		{%- endif -%}
	</a>
{%- endif -%}
