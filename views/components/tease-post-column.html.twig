{#
 # Components: Tease Post Column
 #
 # Lightweight blog teaser column: node rule, date · category · reading time, title, excerpt, read link.
 # Schema.org: BlogPosting (headline, description, url, datePublished, dateModified, author, articleSection, timeRequired).
 #
 # @param object post Timber post.
 # @param array classes Optional extra classes.
 #}

{%- if post -%}
	{%- set category =
		post.categories
			| default( [] )
			| filter( term => term.slug not in [ 'uncategorized', 'non-classe' ] )
			| first
	-%}
	{%- set excerpt =
		post.excerpt( {
			words: 22,
			read_more: false,
		} )
	-%}

	<article
		class="{{
			html_classes(
				'group/tease-post relative flex flex-col space-y-5',
				classes | default( [] ) | join( ' ' )
			)
		}}"
		itemscope
		itemtype="https://schema.org/BlogPosting"
		itemprop="item"
	>
		<div
			class="group-hover/tease-post:after:bg-accent-default relative h-3 w-full before:absolute before:top-1/2 before:right-0 before:left-1.5 before:h-px before:bg-(--border-color-default) after:absolute after:top-1/2 after:left-0 after:size-2.75 after:-translate-y-1/2 after:rounded-full after:bg-(--text-color-primary) after:ring-4 after:ring-(--background-color-default) after:transition-[background-color,transform] after:duration-300 after:ease-out group-hover/tease-post:after:scale-125"
			aria-hidden="true"
		></div>

		<div class="flex flex-col space-y-3">
			<p class="text-eyebrow text-subtle">
				<time datetime="{{ post.date( 'c' ) }}" itemprop="datePublished">
					{{- post.date( 'j F Y' ) | upper -}}
				</time>
				{%- if category -%}
					<span aria-hidden="true">{{ ' · ' }}</span>
					<span itemprop="articleSection">{{- category.name -}}</span>
				{%- endif -%}
				{%- if post.reading_time -%}
					<span aria-hidden="true">{{ ' · ' }}</span>
					<span>{{- __( '%d min read', 'agencecinq' ) | format( post.reading_time ) -}}</span>
					<meta itemprop="timeRequired" content="PT{{ post.reading_time }}M" />
				{%- endif -%}
			</p>

			<h3 class="text-title-md text-primary" itemprop="headline">
				<a href="{{ post.link }}" class="after:absolute after:inset-0" itemprop="url">
					{{- post.title -}}
				</a>
			</h3>

			{%- if excerpt | trim -%}
				<p class="text-muted text-sm" itemprop="description">{{- excerpt -}}</p>
			{%- endif -%}
		</div>

		<p class="text-primary pointer-events-none inline-flex items-center gap-1.5 text-sm">
			{{- __( 'Read the article', 'agencecinq' ) -}}
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'arrow',
						classes: [ 'size-3' ],
					},
					with_context: false
				)
			-}}
		</p>

		<meta itemprop="dateModified" content="{{ post.modified( 'c' ) }}" />
		<meta
			itemprop="author"
			content="{{ post.author.name | default( 'AgenceCinq' ) | e( 'html_attr' ) }}"
		/>
	</article>
{%- endif -%}
