{#
 # Browser Frame
 # Screenshot or video of the delivered site in a browser chrome (16:10).
 #
 # @param {array|int} [image] Image object or ID. Optional.
 # @param {array|string} [video] Video file array (with url) or URL string. Optional.
 # @param {array|string} [poster] Poster image array (with url) or URL string. Optional.
 # @param {array} [classes] Extra classes on the figure.
 # @param {string} [loading] Loading attribute. Defaults to 'lazy'.
 # @param {string} [sizes] Sizes attribute for the image.
 # @param {string} [alt] Alt text.
 # @param {object} [attributes] Extra attributes on the img / video.
 #}

{%- set video_url = video.url | default(video) -%}
{%- set poster_url = poster.url | default(poster) -%}

{%- if image or video_url -%}
	<figure
		class="{{
		html_classes(
			'border-cream-soft bg-gray rounded-10 relative overflow-hidden border',
			"before:bg-medium-gray before:block before:h-8 before:w-full before:content-['']",
			"after:bg-stone after:pointer-events-none after:absolute after:top-4 after:left-3.5 after:z-1 after:size-2.25 after:-translate-y-1/2 after:rounded-full after:shadow-[1rem_0_0_var(--color-stone),2rem_0_0_var(--color-stone)] after:content-['']",
			classes | default([]) | join(' ')
		)
		}}"
	>
		<div class="bg-dark-gray aspect-16/10">
			{%- if video_url -%}
				<video
					class="size-full object-cover object-top"
					src="{{ video_url }}"
					{% if poster_url %}poster="{{ poster_url }}"{% endif %}
					autoplay
					muted
					loop
					playsinline
					{% for key, value in attributes | default({}) %}
						{{ key }}="{{ value }}"
					{% endfor %}
				></video>
			{%- else -%}
				{{-
					include(
						'components/image.html.twig',
						{
							image: image,
							classes: ['size-full object-cover object-top'],
							loading: loading | default('lazy'),
							sizes: sizes | default(null),
							alt: alt | default(null),
							attributes: attributes | default({})
						},
						with_context = false
					)
				-}}
			{%- endif -%}
		</div>
	</figure>
{%- endif -%}
