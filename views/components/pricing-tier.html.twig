{#
 # Pricing tier: name, price, included lines.
 # Takes a catalogue package, retainer or module, or a tier typed in the block with the same fields.
 # Featured variant uses accent chrome. Badge is independent of featured.
 #
 # @param string name The tier name.
 # @param float|null priceExclVat The price, null on quote.
 # @param float|null monthlyPriceExclVat The monthly price of a retainer, instead of priceExclVat.
 # @param array priceMode The price mode, { id }.
 # @param array included The included lines, as strings.
 # @param bool featured Whether this tier is highlighted.
 # @param string badge Optional badge label.
 # @param bool reserve_badge Keep the badge space without a badge, to line up with sibling tiers.
 #}

{%- set included = included | default( [] ) -%}
{%- set quote = priceMode.id == constant( 'AgenceCinq\\Catalogue\\Catalogue::QUOTE' ) -%}
{%- set monthly = monthlyPriceExclVat is defined -%}
{%- set amount = monthly ? monthlyPriceExclVat : priceExclVat -%}

{%- if badge or name or amount or quote -%}
	<article
		class="{{
			html_classes(
				'flex w-full flex-col space-y-3 rounded-md border p-8',
				featured ? 'border-accent bg-accent-soft' : 'border-default bg-default',
				reserve_badge and not badge ? 'md:pt-18'
			)
		}}"
	>
		<div class="{{ html_classes( badge ? 'space-y-4' ) }}">
			{%- if badge -%}
				<p class="text-eyebrow bg-accent-default text-on-accent block w-fit rounded-sm px-2 py-1">
					{{- badge -}}
				</p>
			{%- endif -%}

			{%- if name or amount or quote -%}
				<div class="space-y-2.5">
					{%- if name -%}
						<h3 class="text-title-md text-muted wrap-break-word hyphens-auto" itemprop="name">
							{{- name -}}
						</h3>
					{%- endif -%}

					{%- if amount is not empty or quote -%}
						{%- set price = monthly
							? {
								monthlyPriceExclVat: amount,
								priceMode: priceMode,
							} | retainer_price
							: {
								priceExclVat: amount,
								priceMode: priceMode,
							} | price
						-%}

						<p class="text-title-lg text-primary">
							{%- if amount is not empty -%}
								<data itemprop="price" value="{{ amount }}">{{- price -}}</data>
							{%- else -%}
								{{- price -}}
							{%- endif -%}
						</p>
					{%- endif -%}
				</div>
			{%- endif -%}
		</div>

		{%- if included | length -%}
			<ul class="border-default space-y-3 border-t pt-6">
				{%- for line in included -%}
					<li
						class="{{
							html_classes(
								'text-muted flex gap-2.5 text-sm before:mt-1.5 before:size-1.25 before:shrink-0 before:rounded-full',
								featured ? 'before:bg-accent-default' : 'before:bg-(--text-color-muted)'
							)
						}}"
					>
						{{- line -}}
					</li>
				{%- endfor -%}
			</ul>
		{%- endif -%}
	</article>
{%- endif -%}
