{#
 # Components: Badge
 #
 # Data label (status, duration, situation) in Label/eyebrow.
 # The dot never carries information alone (RGAA 3.1): the label says it.
 #
 # @param string title The badge label.
 # @param bool dot Optional. Dot before the label.
 # @param string tone Optional. Colour of the dot: 'accent' (default) or 'neutral'.
 # @param array classes Optional extra classes.
 #}

{%- set tone = tone | default( 'accent' ) -%}

{%- if title -%}
	<span
		class="{{
			html_classes(
				'border-default text-eyebrow text-muted inline-flex items-center gap-2 rounded-sm border px-2 py-1',
				dot ? 'before:size-1.5 before:shrink-0 before:rounded-full',
				dot and tone == 'accent' ? 'before:bg-accent-default',
				dot and tone == 'neutral' ? 'before:bg-(--text-color-subtle)',
				classes | default( [] ) | join( ' ' )
			)
		}}"
	>
		{{- title -}}
	</span>
{%- endif -%}
