{#
 # Components: Button
 #
 # @param string title The button text.
 # @param string url The URL the link points to. Can be empty if the button is not a link. If the url is given, the button will be rendered as a a tag instead of a button tag.
 # @param string target The target attribute for the link, either '_self' or '_blank'. Only applicable if url is provided.
 # @param string variant Variant of the button: 'primary' (pistachio pill + arrow), 'secondary' (underline), 'tertiary' (nav pill) or 'quaternary' (utility).
 # @param bool disabled
 # @param string icon Icon name, used by the quaternary variant.
 # @param string icon_html Optional raw icon markup, used instead of `icon`.
 # @param attributes Additional HTML attributes for the button element, passed as an associative array (e.g. { 'data-toggle': 'modal', 'aria-label': 'Open modal' }).
 # @param array classes Additional CSS classes to apply to the button, passed as an array (e.g. [ 'my-custom-class', 'another-class' ]).
 #}

{%- set variant = variant | default( 'primary' ) -%}
{%- set disabled = disabled | default( false ) -%}
{%- set icon = icon | default( '' ) -%}

{%- if icon_html is not defined -%}
	{%- set icon_html = '' -%}
	{%- if variant == 'quaternary' and icon is not empty -%}
		{%- set icon_html -%}
			{{- include( 'svg/use.html.twig', { classes: [ 'size-2.5' ], icon: icon } ) -}}
		{%- endset -%}
	{%- endif -%}
{%- endif -%}

{%- set show_arrow = variant == 'primary' and icon_html is empty -%}

{%- if title -%}
	<{{ url ? 'a' : 'button' }}
		{{ url ? "href=\"#{url}\"" : "type=\"#{ type | default( 'button' ) }\"" }}
		{{ url and target ? "target=\"#{target}\"" : '' }}
		{{ url and target == '_blank' ? 'rel="noopener noreferrer"' : '' }}
		class="{{
		html_classes(
			classes | default( [] ) | join( ' ' ),
			'button inline-flex items-center whitespace-nowrap transition-colors duration-300 ease-out',
			'button--' ~ variant,
			disabled ? 'pointer-events-none cursor-not-allowed opacity-50' : '',
			variant == 'primary' ? 'gap-2 rounded-full bg-pistachio px-6 py-3.5 text-cta text-off-black hover:bg-light-pistachio focus-visible:bg-light-pistachio' : '',
			variant == 'secondary' ? 'border-b border-stone pb-0.75 text-cta text-cream hover:border-pistachio hover:text-pistachio focus-visible:border-pistachio focus-visible:text-pistachio' : '',
			variant == 'tertiary' ? 'rounded-full bg-pistachio px-4.5 py-2.5 text-label text-off-black hover:bg-light-pistachio focus-visible:bg-light-pistachio' : '',
			variant == 'quaternary' ? 'gap-0.75 text-cta text-cream hover:text-pistachio focus-visible:text-pistachio' : ''
		)
		}}"
		{{ disabled ? 'disabled' }}
		{{ attributes ? attributes | map( ( value, key ) => value == '' ? key : "#{key}=\"#{value}\"" ) | join( ' ' ) | raw }}
	>
		{%- if icon_html is not empty -%}
			{{- icon_html -}}
		{%- endif -%}
		<span>{{- title -}}</span>
		{%- if show_arrow -%}
			<span aria-hidden="true">→</span>
		{%- endif -%}
	</{{ url ? 'a' : 'button' }}>
{%- endif -%}
