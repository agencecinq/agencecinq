{#
 # Components: Button
 #
 # Link or button in Label/button. Primary: main action, one per section. Secondary: text/subtle outline.
 # Text: underlined link. Primary and Secondary are not underlined: their shape identifies them.
 #
 # @param string title The button text.
 # @param string url Optional. Renders an <a> when set, a <button> otherwise.
 # @param string target Optional. For links: '_self' or '_blank'.
 # @param string type Optional. Button type without url: 'button' (default) or 'submit'.
 # @param string variant Optional. 'primary' (default), 'secondary' or 'text'.
 # @param bool arrow Optional. Trailing arrow, true by default.
 # @param bool disabled Optional.
 # @param object attributes Optional extra HTML attributes.
 # @param array classes Optional extra classes.
 #}

{%- set variant = variant | default( 'primary' ) -%}

{%- if title -%}
	<{{ url ? 'a' : 'button' }}
		class="{{
			html_classes(
				'text-button inline-flex items-center gap-2 whitespace-nowrap transition-colors duration-300 ease-out',
				'focus-visible:outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2',
				variant == 'primary'
					? 'bg-accent-default text-on-accent hover:bg-accent-hover rounded-full px-6 py-3.5',
				variant == 'secondary'
					? 'text-primary hover:bg-surface rounded-full border border-(--text-color-subtle) px-6 py-3.5',
				variant == 'text' ? 'text-primary py-1 underline',
				disabled ? 'pointer-events-none opacity-50',
				classes | default( [] ) | join( ' ' )
			)
		}}"
		{{
			html_attr(
				url ? { href: url } : { type: type | default( 'button' ) },
				url and target ? { target: target },
				url and target == '_blank' ? { rel: 'noopener noreferrer' },
				disabled and not url ? { disabled: true },
				attributes | default( {} )
			)
		}}
	>
		{{- title -}}
		{%- if arrow ?? true -%}
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'arrow',
						classes: [ 'size-4 shrink-0' ],
						attributes: { 'aria-hidden': 'true' },
					},
					with_context: false
				)
			-}}
		{%- endif -%}
	</{{ url ? 'a' : 'button' }}>
{%- endif -%}
