{#
 # Components: Page Hero
 # Inner-page hero: overline, title, lead, CTAs, optional meta and image.
 #
 # @param string id Section id (also used for the title element id suffix).
 # @param string overline Uppercase mono label above the title.
 # @param string title Main heading text.
 # @param string text Lead paragraph (excerpt or ACF text).
 # @param array links Link arrays (title, url, target). First = primary, next = secondary.
 # @param array meta Optional label items with a text key.
 # @param array|int image Optional right-hand image.
 # @param string heading Heading tag. Defaults to h1.
 # @param array classes Extra classes for the section.
 #}

{%- set title_id = id ? id ~ '-title' : 'page-title' -%}
{%- set link_items = links is iterable ? links | filter(link => link.title) : [] -%}
{%- set meta_items = meta is iterable ? meta | filter(item => item.text) : [] -%}

{%- if overline or title or text or link_items | length or image -%}
	<section
		id="{{ id | default('page-hero') }}"
		class="{{ html_classes(classes | default([]) | join(' ')) }}"
		{{ title ? 'aria-labelledby="' ~ title_id ~ '"' }}
	>
		<div class="layout-grid container items-center gap-y-12">
			<div class="col-span-full space-y-14 {{ image ? 'lg:col-span-7' : 'lg:col-span-9' }}">
				{%- if overline or title or text -%}
					<div class="space-y-8">
						{%- if overline or title -%}
							<header class="space-y-6">
								{%- if overline -%}
									<p class="text-label text-taupe uppercase">
										{{- overline -}}
									</p>
								{%- endif -%}

								{%- if title -%}
									<{{ heading | default('h1') }} id="{{ title_id }}" class="text-title-xxl">
										{{- title -}}
									</{{ heading | default('h1') }}>
								{%- endif -%}
							</header>
						{%- endif -%}

						{%- if text -%}
							<p class="text-taupe max-w-190 text-xl">
								{{- text | raw -}}
							</p>
						{%- endif -%}
					</div>
				{%- endif -%}

				{%- if link_items | length or meta_items | length -%}
					<div class="space-y-6">
						{%- if link_items | length -%}
							<div class="flex flex-wrap items-center gap-4">
								{%- for link in link_items -%}
									{{-
										include(
											'components/button.html.twig',
											link | merge({ variant: loop.first ? 'primary' : 'secondary' }),
											with_context = false
										)
									-}}
								{%- endfor -%}
							</div>
						{%- endif -%}

						{%- if meta_items | length -%}
							<ul class="text-label text-stone flex flex-wrap items-center gap-x-4.5 gap-y-2 uppercase">
								{%- for item in meta_items -%}
									<li class="after:bg-cream-soft flex items-center after:ms-4.5 after:h-3.5 after:w-px last:after:hidden">
										{{- item.text -}}
									</li>
								{%- endfor -%}
							</ul>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>

			{%- if image -%}
				<div class="col-span-full lg:col-span-5">
					{{-
						include(
							'components/image.html.twig',
							{
								image: image,
								classes: ['size-full'],
								sizes: '(min-width: 64rem) 40vw, 100vw',
								loading: 'eager'
							},
							with_context = false
						)
					-}}
				</div>
			{%- endif -%}
		</div>
	</section>
{%- endif -%}
