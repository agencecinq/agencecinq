{#
 # Components: Grid
 #
 # Debug overlay of `.layout-grid` on `.container`: 4 columns below `lg`, 12 above.
 # Hidden by default. Press G to toggle.
 #}
<cinq-grid class="pointer-events-none fixed inset-0 z-50" hidden aria-hidden="true">
	<div class="layout-grid container h-full">
		{%- for i in 1..12 -%}
			<div
				class="{{
					html_classes(
						cycle( [ 'bg-accent-default/12', 'bg-accent-default/6' ], loop.index0 ),
						'relative h-full',
						loop.index > 4 ? 'max-lg:hidden'
					)
				}}"
			>
				<span class="text-mono text-accent-default/70 absolute inset-x-0 bottom-2 text-center">
					{{- loop.index -}}
				</span>
			</div>
		{%- endfor -%}
	</div>
</cinq-grid>
