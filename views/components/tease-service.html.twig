{#
 # Components: Tease Service
 #
 # Column of the “bus système” list: node rule, index, title, text, link.
 # Schema.org: Service (name, description, url).
 #
 # @param string title
 # @param string text
 # @param object link { title, url, target }
 # @param string index Index label, e.g. "01/03".
 # @param string heading Heading tag for the title. Defaults to h3.
 # @param array classes
 #}

{%- set link = link | default({}) -%}
{%- set heading = heading | default('h3') -%}
{%- if title or text or link.url -%}
	<article
		class="{{
		html_classes(
			'group/tease-service relative flex flex-col space-y-5',
			classes | default([]) | join(' ')
		)
		}}"
		itemscope
		itemtype="https://schema.org/Service"
		itemprop="item"
	>
		<div
			class="before:bg-cream-soft after:bg-cream after:ring-black group-hover/tease-service:after:bg-pistachio relative h-3 w-full before:absolute before:top-1/2 before:right-0 before:left-1.5 before:h-px before:content-[''] after:absolute after:top-1/2 after:left-0 after:size-2.75 after:-translate-y-1/2 after:rounded-full after:ring-4 after:transition-[background-color,transform] after:duration-300 after:ease-out after:content-[''] group-hover/tease-service:after:scale-125"
			aria-hidden="true"
		></div>

		<div class="flex flex-col space-y-3">
			{%- if index -%}
				<p class="text-label text-stone">
					{{- index -}}
				</p>
			{%- endif -%}

			{%- if title -%}
				<{{ heading }} class="text-title-md text-cream" itemprop="name">
					{{- title -}}
				</{{ heading }}>
			{%- endif -%}

			{%- if text -%}
				<p class="text-sm text-taupe" itemprop="description">
					{{- text | raw -}}
				</p>
			{%- endif -%}
		</div>

		{%- if link.url and link.title -%}
			<a
				href="{{ link.url }}"
				class="text-cta text-cream inline-flex items-center gap-1.5 hover:text-pistachio"
				itemprop="url"
				{{ link.target ? "target=\"#{ link.target }\"" }}
				{{ link.target == '_blank' ? 'rel="noopener noreferrer"' }}
			>
				{{- link.title -}}
			</a>
		{%- endif -%}
	</article>
{%- endif -%}
