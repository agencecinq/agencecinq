{#
 # Components: Tease Service
 #
 # Column of the “bus système” list: node rule, index, title, text, link.
 # Schema.org: Service (name, description, url).
 #
 # @param string title
 # @param string text
 # @param object link { title, url, target }
 # @param string index Index label, e.g. "01/03".
 # @param string heading Heading tag for the title. Defaults to h3.
 # @param array classes
 #}

{%- set link = link | default( {} ) -%}
{%- set heading = heading | default( 'h3' ) -%}
{%- if title or text or link.url -%}
	<article
		class="{{
			html_classes(
				'group/tease-service relative flex flex-col space-y-5',
				classes | default( [] ) | join( ' ' )
			)
		}}"
		itemscope
		itemtype="https://schema.org/Service"
		itemprop="item"
	>
		<div
			class="group-hover/tease-service:after:bg-accent-default relative h-3 w-full before:absolute before:top-1/2 before:right-0 before:left-1.5 before:h-px before:bg-(--border-color-default) after:absolute after:top-1/2 after:left-0 after:size-2.75 after:-translate-y-1/2 after:rounded-full after:bg-(--text-color-primary) after:ring-4 after:ring-(--background-color-default) after:transition-[background-color,transform] after:duration-300 after:ease-out group-hover/tease-service:after:scale-125"
			aria-hidden="true"
		></div>

		<div class="flex flex-col space-y-3">
			{%- if index -%}
				<p class="text-subtle text-sm">{{- index -}}</p>
			{%- endif -%}

			{%- if title -%}
				<{{ heading }} class="text-title-md text-primary" itemprop="name">
					{{- title -}}
				</{{ heading }}>
			{%- endif -%}

			{%- if text -%}
				<p class="text-muted text-sm" itemprop="description">{{- text | raw -}}</p>
			{%- endif -%}
		</div>

		{%- if link.url and link.title -%}
			<a
				href="{{ link.url }}"
				class="text-button text-primary hover:text-accent-default inline-flex items-center gap-1.5"
				itemprop="url"
				{{ link.target ? "target=\"#{ link.target }\"" }}
				{{ link.target == '_blank' ? 'rel="noopener noreferrer"' }}
			>
				{{- link.title -}}
			</a>
		{%- endif -%}
	</article>
{%- endif -%}
