{#
 # Components: Mobile menu
 #
 # Figma Overlay/Drawer: a bar with the logo and « Close », which takes the focus on open, the Drawer links,
 # whose level 2 a <cinq-disclosure-button> unfolds, then the actions and the phone. When level 2 holds
 # groups, each one keeps its name above its links, as in the Submenu.
 #
 # @param array items Main menu items.
 # @param object contact Contact options: link, phone.
 # @param object secondary Optional. Secondary link of the header.
 #}

<div class="flex min-h-full flex-col">
	<div class="flex items-center justify-between py-3.75">
		<a
			href="{{ function( 'home_url', '/' ) }}"
			class="focus-visible:outline-focus-ring block h-6 w-20 shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2"
			aria-label="{{ __( 'CINQ, home', 'agencecinq' ) }}"
		>
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'logo',
						classes: [ 'size-full' ],
						attributes: { 'aria-hidden': 'true' },
					},
					with_context: false
				)
			-}}
		</a>
		<cinq-drawer-button class="block">
			{{-
				include(
					'components/icon-button.html.twig',
					{
						label: __( 'Close', 'agencecinq' ),
						icon: 'close',
						attributes: {
							'aria-controls': 'menu-drawer',
							'aria-expanded': 'false',
							autofocus: true,
						},
					},
					with_context: false
				)
			-}}
		</cinq-drawer-button>
	</div>

	{%- if items | length -%}
		<nav aria-label="{{ __( 'Mobile navigation', 'agencecinq' ) }}">
			<ul>
				{%- for item in items -%}
					<li>
						{%- if item.children | length -%}
							<cinq-disclosure-button class="block">
								{{-
									include(
										'components/drawer-link.html.twig',
										{
											title: item.title,
											controls: 'drawer-sublinks-' ~ item.id,
											current: item.current or item.current_item_ancestor,
										},
										with_context: false
									)
								-}}
							</cinq-disclosure-button>
							<div id="drawer-sublinks-{{ item.id }}" hidden>
								{%- for group in item.children | filter( child => child.children | length ) -%}
									<p
										id="drawer-group-{{ group.id }}"
										class="text-eyebrow text-muted ps-4 pt-4 pb-1"
									>
										{{- group.title -}}
									</p>
									<ul aria-labelledby="drawer-group-{{ group.id }}">
										{%- for link in group.children -%}
											<li>
												{{-
													include(
														'components/drawer-sublink.html.twig',
														{
															title: link.title,
															url: link.url,
															current: link.current,
														},
														with_context: false
													)
												-}}
											</li>
										{%- endfor -%}
									</ul>
								{%- else -%}
									<ul>
										{%- for link in item.children -%}
											<li>
												{{-
													include(
														'components/drawer-sublink.html.twig',
														{
															title: link.title,
															url: link.url,
															current: link.current,
														},
														with_context: false
													)
												-}}
											</li>
										{%- endfor -%}
									</ul>
								{%- endfor -%}
							</div>
						{%- else -%}
							{{-
								include(
									'components/drawer-link.html.twig',
									{
										title: item.title,
										url: item.url,
										current: item.current,
									},
									with_context: false
								)
							-}}
						{%- endif -%}
					</li>
				{%- endfor -%}
			</ul>
		</nav>
	{%- endif -%}

	<div class="mt-auto flex flex-col items-start gap-3 pt-8">
		{%- if contact.link | default( false ) -%}
			{{-
				include(
					'components/button.html.twig',
					contact.link | merge( {
						arrow: false,
						classes: [ 'w-full justify-center' ],
					} ),
					with_context: false
				)
			-}}
		{%- endif -%}
		{%- if secondary -%}
			{{-
				include(
					'components/button.html.twig',
					secondary | merge( {
						variant: 'secondary',
						arrow: false,
						classes: [ 'w-full justify-center' ],
					} ),
					with_context: false
				)
			-}}
		{%- endif -%}
		{%- if contact.phone | default( false ) -%}
			<a
				href="tel:{{ contact.phone | tel }}"
				class="text-primary focus-visible:outline-focus-ring text-base underline focus-visible:outline-2 focus-visible:outline-offset-2"
			>
				{{- contact.phone -}}
			</a>
		{%- endif -%}
	</div>
</div>
