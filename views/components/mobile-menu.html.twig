{#
 # Mobile menu content: main panel and sub panels (drill-down).
 # Used inside the drawer. JS (cinq-mobile-menu) toggles [data-panel="main"] vs [data-panel="sub"].
 #
 # @param array items Main menu items (from nav_menus.main.get_items()).
 #}

{% macro cta(link) %}
	{%- if link -%}
		<div class="mt-auto">
			{{-
				include(
					'components/button.html.twig',
					link
						| default({})
						| merge({
							variant: 'primary',
							classes: ['w-full justify-center']
						}),
					with_context = false
				)
			-}}
		</div>
	{%- endif -%}
{% endmacro %}

<div data-dom="main" data-panel="main" class="relative flex min-h-full flex-col space-y-8">
	{%- if items | length -%}
		<nav
			aria-label="{{ __('Mobile navigation', 'agencecinq') }}"
			class="w-full flex-1 overflow-y-auto"
		>
			<ul>
				{% for item in items %}
					<li
						class="border-cream-faint border-b"
						itemscope
						itemtype="https://schema.org/SiteNavigationElement"
					>
						{% if item.children | length %}
							<button
								type="button"
								data-dom="open-sub"
								data-open-sub="{{ item.id }}"
								class="text-title-md text-cream flex w-full items-center justify-between py-4.5 text-left"
								aria-expanded="false"
								aria-controls="mobile-sub-{{ item.id }}"
							>
								<span itemprop="name">{{- item.title -}}</span>
								<span class="text-pistachio text-lg" aria-hidden="true">→</span>
							</button>
						{% else %}
							<a
								class="text-title-md text-cream block py-4.5"
								href="{{ item.url }}"
								itemprop="url"
								{{
								item.is_target_blank or item.is_external
									? 'target="' ~ item.target ~ '" rel="noopener noreferrer"'
								}}
							>
								<span itemprop="name">{{- item.title -}}</span>
							</a>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		</nav>
	{%- endif -%}

	{{- _self.cta(theme.contact.link | default(null)) -}}
</div>

{% for item in items %}
	{%- if item.children | length -%}
		<div
			data-dom="sub"
			data-panel="sub"
			data-sub-id="{{ item.id }}"
			id="mobile-sub-{{ item.id }}"
			class="absolute inset-0 flex min-h-full flex-col"
			aria-hidden="true"
			style="display: none;"
		>
			<div class="border-cream/11 flex h-16 shrink-0 items-center justify-between border-b">
				<button
					type="button"
					data-dom="back-to-main"
					class="text-title-md text-cream flex items-center gap-2.5"
					aria-label="{{ __('Back to menu', 'agencecinq') }}"
				>
					<span class="text-pistachio text-lg" aria-hidden="true">←</span>
					{{- __('Back', 'agencecinq') -}}
				</button>
			</div>

			<nav class="w-full flex-1 overflow-y-auto" aria-label="{{ item.title }}">
				<ul>
					{%- for child in item.children -%}
						<li
							class="border-cream-faint border-b"
							itemscope
							itemtype="https://schema.org/SiteNavigationElement"
						>
							{%- if child.url != '#' -%}
								<a
									href="{{ child.url }}"
									itemprop="url"
									class="text-title-md text-cream block py-4.5"
									{{
									child.is_target_blank or child.is_external
										? 'target="' ~ child.target ~ '" rel="noopener noreferrer"'
									}}
								>
									<span itemprop="name">{{- child.title -}}</span>
								</a>
							{%- else -%}
								<span class="text-title-md text-cream block py-4.5" itemprop="name">
									{{- child.title -}}
								</span>
							{%- endif -%}
						</li>
					{%- endfor -%}

					<li>
						<a
							href="{{ item.url }}"
							class="text-title-md text-cream border-cream-faint block border-b py-4.5"
						>
							{{- __('See all', 'agencecinq') -}}
						</a>
					</li>
				</ul>
			</nav>

			{{- _self.cta(theme.contact.link | default(null)) -}}
		</div>
	{%- endif -%}
{% endfor %}
