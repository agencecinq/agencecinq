{#
 # Components: Tease Editorial Card
 # Framed editorial card with optional figure or data flow.
 #
 # @param string overline Uppercase eyebrow.
 # @param string title Card title.
 # @param string figure Large figure (takes priority over flow).
 # @param string flow_input Left side of an optional data flow.
 # @param string flow_output Right side of an optional data flow.
 # @param string text Supporting text.
 # @param string heading Heading tag for the title. Defaults to h3.
 # @param array classes Extra classes on the article.
 #}

{%- if overline or title or figure or flow_input or flow_output or text -%}
	<article
		class="{{
			html_classes(
				'border-default bg-surface flex h-full min-h-82.5 flex-col justify-between rounded-lg border p-8',
				classes | default( [] ) | join( ' ' )
			)
		}}"
	>
		<div class="space-y-3">
			{%- if overline -%}
				<p class="text-eyebrow text-accent-default">{{- overline -}}</p>
			{%- endif -%}

			{%- if title -%}
				<{{ heading | default( 'h3' ) }} class="text-title-lg">
					{{- title -}}
				</{{ heading | default( 'h3' ) }}>
			{%- endif -%}
		</div>

		{%- if figure -%}
			<p class="text-title-xxl text-accent-default py-8 tabular-nums lg:py-10">{{- figure -}}</p>
		{%- elseif flow_input or flow_output -%}
			<div class="text-eyebrow flex flex-wrap items-center gap-4.5 py-8 lg:py-10">
				{%- if flow_input -%}
					<span class="text-muted">{{- flow_input -}}</span>
				{%- endif -%}
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow-right',
							classes: [ 'size-5.5 fill-current text-subtle' ],
						},
						with_context: false
					)
				-}}
				{%- if flow_output -%}
					<span class="bg-accent-soft text-accent-default rounded-md px-3.5 py-2.5">
						{{- flow_output -}}
					</span>
				{%- endif -%}
			</div>
		{%- endif -%}

		{%- if text -%}
			<p class="text-muted text-sm">{{- text | raw -}}</p>
		{%- endif -%}
	</article>
{%- endif -%}
