{#
 # Components: Drawer
 #
 # CINQ UI Drawer on a native modal <dialog>, full screen: the page behind is inert, Escape closes it
 # and the focus goes back to its button. The [autofocus] element takes the focus on open. It fades
 # from CSS, without animation for reduced motion.
 #
 # @param string id Id that the drawer buttons control.
 # @param string aria_label Name of the dialog.
 # @param array classes Optional extra classes on the dialog.
 #
 # @example
 # {% embed 'components/drawer.html.twig' with { id: 'menu-drawer', aria_label: 'Menu' } only %}
 #	{% block content %}…{% endblock %}
 # {% endembed %}
 #}

<cinq-drawer id="{{ id }}">
	<dialog
		class="{{
			html_classes(
				'bg-default text-primary m-0 size-full max-h-none max-w-none overflow-y-auto overscroll-contain border-0 pb-6',
				'opacity-0 transition-[opacity,display,overlay] transition-discrete duration-300 ease-out open:opacity-100 motion-reduce:transition-none starting:open:opacity-0',
				classes | default( [] ) | join( ' ' )
			)
		}}"
		aria-label="{{ aria_label }}"
	>
		{%- block content -%}{%- endblock -%}
	</dialog>
</cinq-drawer>
