{#
 # Components: Tease Case study card
 # Showroom card: browser frame, client, platform · year, link to the case.
 #
 # Schema.org: Article (headline, image, url).
 #
 # @param {object} post The case study post. Required.
 # @param {string} [sizes] Sizes attribute for the screenshot image.
 # @param {array} [classes] Extra classes on the article.
 #}

{%- if post -%}
	{%- set client = post.client | default(post.title) -%}
	{%- set platform = post.platform | default('') -%}
	{%- set year = post.year | default('') -%}

	<article
		class="{{ html_classes(classes | default([]) | join(' ')) }}"
		itemscope
		itemtype="https://schema.org/Article"
		itemprop="item"
	>
		<a
			href="{{- post.link -}}"
			itemprop="url"
			class="group flex flex-col gap-4"
			aria-label="{{ __('View the case: %s', 'agencecinq') | format(client) }}"
		>
			{{-
				include(
					'components/browser-frame.html.twig',
					{
						image: post.screenshot,
						video: post.video,
						poster: post.poster,
						sizes: sizes | default(null),
						alt: client,
						attributes: {
							itemprop: 'image'
						}
					},
					with_context = false
				)
			-}}

			<div class="flex items-center justify-between gap-3 overflow-hidden whitespace-nowrap">
				<div class="flex min-w-0 flex-1 items-center gap-3 overflow-hidden">
					{%- if client -%}
						<p class="text-title-md min-w-0 truncate" itemprop="headline">
							{{- client -}}
						</p>
					{%- endif -%}

					{%- if platform or year -%}
						<p class="text-label text-stone shrink-0">
							{%- if platform -%}
								{{- platform -}}
							{%- endif -%}
							{%- if platform and year -%}
								{{- ' · ' -}}
							{%- endif -%}
							{%- if year -%}
								<time datetime="{{ year }}" itemprop="dateCreated">{{- year -}}</time>
							{%- endif -%}
						</p>
					{%- endif -%}
				</div>

				<p class="text-label text-taupe group-hover:text-cream shrink-0 transition-colors">
					{{- __('View the case', 'agencecinq') ~ ' →' -}}
				</p>
			</div>
		</a>
	</article>
{%- endif -%}
