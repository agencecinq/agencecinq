{#
 # Components: Checkbox
 #
 # Native checkbox drawn as a box, its label on the right. The check mark shows with :checked, on top of
 # the colour. The box stays on the first line of a long label.
 #
 # @param string id Ties the label to the box.
 # @param string label
 # @param object attributes Optional box attributes: name, value, checked, required, disabled…
 # @param array classes Optional extra classes.
 #}

<div
	class="{{
		html_classes(
			'flex items-start gap-3 py-2.5 text-base has-disabled:opacity-50',
			classes | default( [] ) | join( ' ' )
		)
	}}"
>
	<span class="grid h-lh shrink-0 place-items-center">
		<input
			id="{{ id }}"
			type="checkbox"
			class="{{
				html_classes(
					'peer border-control bg-surface col-start-1 row-start-1 size-5 appearance-none rounded-sm border-[1.5px]',
					'checked:border-accent-default checked:bg-accent-default',
					'focus-visible:outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2'
				)
			}}"
			{{ html_attr( attributes | default( {} ) ) }}
		/>
		{{-
			include(
				'svg/use.html.twig',
				{
					icon: 'check',
					classes: [
						'text-on-accent pointer-events-none invisible col-start-1 row-start-1 size-4 peer-checked:visible',
					],
					attributes: { 'aria-hidden': 'true' },
				},
				with_context: false
			)
		-}}
	</span>
	<label for="{{ id }}">{{- label -}}</label>
</div>
