{#
 # Components: List item
 #
 # A li with a decorative marker: + for compact (cards), default (in a text) and divided (with a rule),
 # a checked box for check (what is included). The marker sits on the first line.
 #
 # @param string text
 # @param string type Optional. 'compact', 'default' (default), 'divided' or 'check'.
 # @param array classes Optional extra classes.
 #}

{%- set type = type | default( 'default' ) -%}

<li
	class="{{
		html_classes(
			'flex items-start',
			type == 'compact' ? 'text-body gap-2.5 text-sm',
			type == 'default' ? 'text-body gap-3 text-lg',
			type == 'divided' ? 'border-default text-primary gap-4 border-b py-4 text-lg',
			type == 'check' ? 'text-body gap-3 text-base',
			classes | default( [] ) | join( ' ' )
		)
	}}"
>
	{%- if type == 'check' -%}
		<span class="grid h-lh shrink-0 place-items-center">
			{{-
				include(
					'svg/use.html.twig',
					{
						icon: 'check-box',
						classes: [ 'text-accent-default size-5' ],
						attributes: { 'aria-hidden': 'true' },
					},
					with_context: false
				)
			-}}
		</span>
	{%- else -%}
		<span class="text-diff-plus shrink-0 font-mono font-medium" aria-hidden="true">+</span>
	{%- endif -%}
	<span class="min-w-0 flex-1">{{- text -}}</span>
</li>
