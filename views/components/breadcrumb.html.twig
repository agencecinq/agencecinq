{#
 # Components: Breadcrumb
 #
 # Ordered list of the levels down to the current page: levels are underlined links, the current page
 # carries aria-current.
 #
 # @param array items Optional. Levels ({ url, text }), the Yoast SEO breadcrumb of the current page by default.
 # @param array classes Optional extra classes.
 #}

{%- set items = items ?? breadcrumbs() -%}

{%- if ( items | length ) > 1 -%}
	<nav
		aria-label="{{ __( 'Breadcrumb', 'agencecinq' ) }}"
		class="{{ html_classes( classes | default( [] ) | join( ' ' ) ) }}"
	>
		<ol class="flex flex-wrap gap-x-2 gap-y-1 text-sm">
			{%- for item in items -%}
				<li class="flex gap-2">
					{%- if not loop.first -%}
						<span class="text-muted" aria-hidden="true">/</span>
					{%- endif -%}
					<a
						href="{{ item.url }}"
						class="{{
							html_classes(
								'focus-visible:outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2',
								loop.last ? 'text-muted' : 'text-body underline'
							)
						}}"
						{{ loop.last ? 'aria-current="page"' }}
					>
						{{- item.text -}}
					</a>
				</li>
			{%- endfor -%}
		</ol>
	</nav>
{%- endif -%}
