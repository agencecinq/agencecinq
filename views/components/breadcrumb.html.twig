{#
 # Components: Breadcrumb
 #
 # Ordered list of the levels down to the current page: levels are underlined links, the current page is not
 # one and carries aria-current. Separators are decorative; Yoast SEO prints the BreadcrumbList schema.
 #
 # @param array items Optional. Levels ({ url, text }), the Yoast SEO breadcrumb of the current page by default.
 # @param array classes Optional extra classes.
 #}

{%- set items = items ?? breadcrumbs() -%}

{%- if ( items | length ) > 1 -%}
	<nav
		aria-label="{{ __( 'Breadcrumb', 'agencecinq' ) }}"
		class="{{ html_classes( classes | default( [] ) | join( ' ' ) ) }}"
	>
		<ol class="flex flex-wrap gap-x-2 gap-y-1 text-sm">
			{%- for item in items -%}
				<li class="flex gap-2">
					{%- if not loop.first -%}
						<span class="text-muted" aria-hidden="true">/</span>
					{%- endif -%}
					{%- if loop.last -%}
						<span class="text-muted" aria-current="page">{{- item.text -}}</span>
					{%- else -%}
						<a
							href="{{ item.url }}"
							class="text-body focus-visible:outline-focus-ring underline focus-visible:outline-2 focus-visible:outline-offset-2"
						>
							{{- item.text -}}
						</a>
					{%- endif -%}
				</li>
			{%- endfor -%}
		</ol>
	</nav>
{%- endif -%}
