{#
 # Components: Pagination
 #
 # @param {object} pagination
 #}

{%- if ( pagination.pages | length ) > 0 -%}
	<nav
		role="navigation"
		class="{{
			html_classes(
				'inline-flex items-center gap-7.5 text-xl',
				classes | default( [] ) | join( ' ' )
			)
		}}"
	>
		{% if pagination.prev %}
			<a
				href="{{ pagination.prev.link }}{{ anchor | default( '' ) }}"
				class="hover:border-accent hover:bg-accent-default flex size-12.5 shrink-0 items-center justify-center rounded-full border transition-colors duration-300 ease-out lg:size-17"
				aria-label="{{ __( 'Previous', 'agencecinq' ) }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow',
							classes: [ 'size-4 -scale-x-100 lg:size-5' ],
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="flex size-12.5 shrink-0 cursor-not-allowed items-center justify-center rounded-full border opacity-50 lg:size-17"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow',
							classes: [ 'size-4 -scale-x-100 lg:size-5' ],
						}
					)
				-}}
			</span>
		{% endif %}

		<ul class="flex flex-wrap justify-center">
			{% for page in pagination.pages %}
				<li>
					{% if page.link %}
						<a
							href="{{ page.link }}{{ anchor | default( '' ) }}"
							class="{{
								page.class
							}} hover:bg-accent-default flex size-10 items-center justify-center rounded-full transition-colors duration-300 ease-out lg:size-12.5"
						>
							{{- page.title -}}
						</a>
					{% else %}
						<span
							class="{{
								html_classes(
									'flex size-10 items-center justify-center rounded-full lg:size-12.5',
									page.class,
									'current' in ( page.class | split( ' ' ) ) ? 'bg-accent-default' : ''
								)
							}}"
							{{ 'current' in ( page.class | split( ' ' ) ) ? 'aria-current="page"' : '' }}
						>
							{{- page.title -}}
						</span>
					{% endif %}
				</li>
			{% endfor %}
		</ul>

		{% if pagination.next %}
			<a
				href="{{ pagination.next.link }}{{ anchor | default( '' ) }}"
				class="hover:bg-accent-default hover:border-accent flex size-12.5 shrink-0 items-center justify-center rounded-full border transition-colors duration-300 ease-out lg:size-17"
				aria-label="{{ __( 'Next', 'agencecinq' ) }}"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow',
							classes: [ 'size-4 lg:size-5' ],
						}
					)
				-}}
			</a>
		{% else %}
			<span
				class="flex size-12.5 shrink-0 cursor-not-allowed items-center justify-center rounded-full border opacity-50 lg:size-17"
			>
				{{-
					include(
						'svg/use.html.twig',
						{
							icon: 'arrow',
							classes: [ 'size-4 lg:size-5' ],
						}
					)
				-}}
			</span>
		{% endif %}
	</nav>
{%- endif -%}
