{#
 # Components: Pagination
 #
 # Previous page as a Text button, next page as a Secondary button, then the position.
 #
 # @param object pagination Timber pagination, e.g. posts.pagination().
 # @param string prev_title Optional. Defaults to "Newer posts".
 # @param string next_title Optional. Defaults to "Older posts".
 # @param string anchor Optional fragment appended to the links.
 # @param array classes Optional extra classes.
 #}

{%- if pagination.total > 1 -%}
	<nav
		aria-label="{{ __( 'Pagination', 'agencecinq' ) }}"
		class="{{
			html_classes( 'flex flex-wrap items-center gap-4', classes | default( [] ) | join( ' ' ) )
		}}"
	>
		{%- if pagination.prev -%}
			{{-
				include(
					'components/button.html.twig',
					{
						title: prev_title | default( __( 'Newer posts', 'agencecinq' ) ),
						url: pagination.prev.link ~ ( anchor | default( '' ) ),
						variant: 'text',
						arrow: false,
					},
					with_context: false
				)
			-}}
		{%- endif -%}

		{%- if pagination.next -%}
			{{-
				include(
					'components/button.html.twig',
					{
						title: next_title | default( __( 'Older posts', 'agencecinq' ) ),
						url: pagination.next.link ~ ( anchor | default( '' ) ),
						variant: 'secondary',
					},
					with_context: false
				)
			-}}
		{%- endif -%}

		<p class="text-muted text-sm">
			{{-
				__( 'Page %1$s of %2$s', 'agencecinq' ) | format( pagination.current, pagination.total )
			-}}
		</p>
	</nav>
{%- endif -%}
