{#
 # Components: Price line
 #
 # A label and its amount, as a dt/dd pair of a dl.
 #
 # @param string label
 # @param string value
 # @param bool total Optional. Last line of an estimate: the label in title-md, the amount in title-lg.
 # @param array classes Optional extra classes.
 #}

{%- set total = total | default( false ) -%}

<div
	class="{{
		html_classes(
			'border-default flex flex-col gap-1 border-b py-5',
			not total ? 'text-button',
			classes | default( [] ) | join( ' ' )
		)
	}}"
>
	<dt class="{{ html_classes( 'text-primary', total ? 'text-title-md' ) }}">{{- label -}}</dt>
	<dd class="{{ total ? 'text-title-lg text-primary' : 'text-muted' }}">{{- value -}}</dd>
</div>
