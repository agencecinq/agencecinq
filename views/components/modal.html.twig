<cinq-modal
	class="{{ html_classes( 'block', classes | default( [] ) | join( ' ' ) ) }}"
	id="{{ id }}"
>
	<dialog
		role="dialog"
		class="scrollbar-hidden backdrop:bg-overlay-scrim m-auto w-full max-w-[calc(100vw-(--spacing(5)))] bg-transparent pt-[1.09375rem] lg:w-114.75 lg:px-[1.09375rem]"
		aria-labelledby=""
	>
		<cinq-modal-button
			class="absolute top-0 right-0 left-0 z-2 mx-auto block w-fit lg:left-auto lg:mx-0"
		>
			{{-
				include(
					'components/icon-button.html.twig',
					{
						label: __( 'Close', 'agencecinq' ),
						icon: 'close',
						attributes: { 'aria-controls': id },
					},
					with_context: false
				)
			-}}
		</cinq-modal-button>

		<div class="bg-default relative z-1 rounded-lg p-7.5">
			{% block content %}{% endblock %}
		</div>
	</dialog>
</cinq-modal>
