{#
 # Eyebrow: brand mark + label.
 #
 # @param string title The eyebrow label.
 # @param string tone Optional. 'neutral' (default) or 'accent' (accent label and mark).
 # @param array classes Optional extra classes.
 #}

{%- set accent = ( tone | default( 'neutral' ) ) == 'accent' -%}

{%- if title -%}
	<p
		class="{{
			html_classes(
				'text-eyebrow flex items-center gap-2',
				accent ? 'text-accent-default' : 'text-muted',
				classes | default( [] ) | join( ' ' )
			)
		}}"
	>
		{{-
			include(
				'svg/use.html.twig',
				{
					icon: 'asterisk',
					classes: [ accent ? 'text-accent-default' : 'text-subtle', 'h-[0.35rem] w-2.5 shrink-0' ],
				},
				with_context: false
			)
		-}}
		{{- title -}}
	</p>
{%- endif -%}
