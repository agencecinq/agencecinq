{#
 # Chip: pill-style filter, button or link (Figma Filter).
 #
 # @param string title The chip label.
 # @param string url Optional. If set, renders an <a> instead of <button>.
 # @param string target Optional. For links: '_self' or '_blank'.
 # @param bool active Optional. Current filter: `aria-current="page"` on a link, `aria-pressed` on a button.
 # @param array classes Additional CSS classes to apply to the chip. Optional.
 #}

{%- set classes =
	[
		'text-button text-primary border-control inline-flex items-center rounded-full border px-4 py-2 transition-colors',
		'hover:bg-surface-hover focus-visible:outline-focus-ring focus-visible:outline-2 focus-visible:outline-offset-2',
		'aria-[current=page]:border-(--text-color-primary) aria-[current=page]:bg-(--text-color-primary) aria-[current=page]:text-(--background-color-default)',
		'aria-pressed:border-(--text-color-primary) aria-pressed:bg-(--text-color-primary) aria-pressed:text-(--background-color-default)',
	]
		| merge( classes | default( [] ) )
		| join( ' ' )
-%}

{%- if url -%}
	<a
		href="{{ url }}"
		class="{{ classes }}"
		{{
			html_attr(
				target == '_blank'
					? {
						target: '_blank',
						rel: 'noopener noreferrer',
					}
					: target ? { target: target },
				active ? { 'aria-current': 'page' },
				attributes | default( {} )
			)
		}}
	>
		{{- title -}}
	</a>
{%- else -%}
	<button
		type="button"
		class="{{ classes }}"
		{{
			html_attr(
				active is defined ? { 'aria-pressed': active ? 'true' : 'false' },
				attributes | default( {} )
			)
		}}
	>
		{{- title -}}
	</button>
{%- endif -%}
