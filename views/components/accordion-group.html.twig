{#
 # Components: Accordion Group
 #
 # @param string id Prefix used for panel ids.
 # @param array items Accordion items with title and text.
 # @param array classes Extra classes for the accordion group.
 #}

{%- set items =
	items | default([]) | filter(item => item.title and (item.text | striptags | trim))
-%}

{%- if items | length -%}
	<cinq-accordion class="{{ html_classes(classes | default([]) | join(' ')) }}">
		{%- for item in items -%}
			{%- set header_id = id ~ '-item-' ~ loop.index -%}
			{%- set panel_id = id ~ '-panel-' ~ loop.index -%}

			<div
				class="border-cream-soft border-b py-6"
				data-panel
				data-open="{{ loop.first ? 'true' : 'false' }}"
				data-deselect="true"
			>
				<button
					type="button"
					class="group text-title-md text-cream aria-expanded:text-pistachio flex w-full cursor-pointer items-center gap-6 text-left"
					data-header
					aria-expanded="{{ loop.first ? 'true' : 'false' }}"
					aria-controls="{{ panel_id }}"
					id="{{ header_id }}"
				>
					<span class="min-w-0 flex-1">{{- item.title -}}</span>

					<span class="text-stone shrink-0 group-aria-expanded:hidden" aria-hidden="true">+</span>
					<span class="hidden shrink-0 group-aria-expanded:inline" aria-hidden="true">−</span>
				</button>

				<div
					class="transition-[max-height] duration-300 ease-out"
					id="{{ panel_id }}"
					role="region"
					aria-labelledby="{{ header_id }}"
					{% if not loop.first %}hidden{% endif %}
				>
					<div class="wysiwyg text-taupe [&_a]:text-pistachio pt-4" data-inner>
						{{- item.text | raw -}}
					</div>
				</div>
			</div>
		{%- endfor -%}
	</cinq-accordion>
{%- endif -%}
