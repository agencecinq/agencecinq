{#
 # Components: Tag
 #}

<button
	type="button"
	class="bg-accent-default text-on-accent text-eyebrow flex items-center gap-0.75 rounded-sm px-1.5 py-0.5"
	{{ attributes
		? attributes
			| map( ( value, key ) => value == '' ? key : "#{ key }=\"#{ value }\"" )
			| join( ' ' )
			| raw }}
>
	{% if icon %}
		{{-
			include(
				'svg/use.html.twig',
				{
					classes: [ 'size-2.5 shrink-0' ],
					icon: icon,
				},
				with_context: false
			)
		-}}
	{% endif %}
	{{- title -}}
</button>
