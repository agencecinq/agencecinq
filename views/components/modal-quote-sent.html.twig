{#
 # Modal: quote sent
 # Confirms the estimate left by e-mail, then offers the next step: booking 30 minutes.
 # Opened by cinq-configurator once /wp-json/cinq/v1/quote answers. Native <dialog> through
 # cinq-modal: focus kept inside, closed by Escape, the × button and a click on the scrim.
 # Centered: 560 px wide, the width of the screen minus the gutters on mobile.
 #
 # @param string id Modal id.
 # @param object modal Texts: eyebrow, title, message ({total}, {email}), help,
 #                     next_eyebrow, next_title, next_text, button_label, note.
 #}

{%- set modal = modal | default( {} ) -%}

<cinq-modal id="{{ id }}" class="block">
	<dialog
		aria-labelledby="{{ id }}-title"
		class="text-primary backdrop:bg-overlay-scrim m-auto max-h-[calc(100dvh-(--spacing(10)))] w-[calc(100vw-(--spacing(5)))] max-w-140 bg-transparent p-0"
	>
		<div
			class="bg-elevated border-default max-h-[inherit] overflow-y-auto rounded-md border p-6 lg:p-14"
		>
			<div class="flex items-center gap-4">
				{{-
					include(
						'components/eyebrow.html.twig',
						{
							title: modal.eyebrow,
							tone: 'accent',
							classes: [ 'flex-1' ],
						},
						with_context: false
					)
				-}}

				<cinq-modal-button class="block shrink-0">
					<button
						type="button"
						aria-controls="{{ id }}"
						class="border-default text-primary focus-visible:outline-focus-ring flex size-11 items-center justify-center rounded-full border text-xl transition-colors hover:border-(--text-color-primary) focus-visible:outline-2 focus-visible:outline-offset-2"
					>
						<span aria-hidden="true">×</span>
						<span class="sr-only">{{ __( 'Close', 'agencecinq' ) }}</span>
					</button>
				</cinq-modal-button>
			</div>

			<h2
				id="{{ id }}-title"
				class="text-title-lg mt-5 outline-none lg:mt-7"
				tabindex="-1"
				data-dom="title"
			>
				{{- modal.title -}}
			</h2>

			<p
				class="text-muted mt-3 text-base"
				role="status"
				data-dom="message"
				data-template="{{ modal.message | e( 'html_attr' ) }}"
			></p>

			{%- if modal.help -%}
				<p class="text-muted mt-2 text-sm">{{- modal.help -}}</p>
			{%- endif -%}

			<div
				class="relative mt-7 h-3 w-full before:absolute before:top-1/2 before:right-0 before:left-1.5 before:h-px before:bg-(--border-color-default) after:absolute after:top-1/2 after:left-0 after:size-2.75 after:-translate-y-1/2 after:rounded-full after:bg-(--text-color-subtle) after:ring-4 after:ring-(--background-color-elevated) lg:mt-9"
				aria-hidden="true"
			></div>

			{{-
				include(
					'components/eyebrow.html.twig',
					{
						title: modal.next_eyebrow,
						classes: [ 'mt-5 lg:mt-7' ],
					},
					with_context: false
				)
			-}}

			{%- if modal.next_title -%}
				<h3 class="text-title-md mt-3">{{- modal.next_title -}}</h3>
			{%- endif -%}

			{%- if modal.next_text -%}
				<p class="text-muted mt-2 text-base">{{- modal.next_text -}}</p>
			{%- endif -%}

			{%- if modal.button_label -%}
				<div class="mt-5 lg:mt-6">
					{{-
						include(
							'components/button.html.twig',
							{
								title: modal.button_label,
								url: '#',
								classes: [ 'w-full justify-center lg:w-auto' ],
								attributes: { 'data-dom': 'booking' },
							},
							with_context: false
						)
					-}}
				</div>
			{%- endif -%}

			{%- if modal.note -%}
				<p class="text-muted mt-4 text-sm">{{- modal.note -}}</p>
			{%- endif -%}
		</div>
	</dialog>
</cinq-modal>
