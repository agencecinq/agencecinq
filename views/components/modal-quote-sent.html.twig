{#
 # Modal: quote sent
 #
 # The Modal that confirms the estimate left by e-mail, then offers the next step: booking 30 minutes.
 # Opened by cinq-configurator once /wp-json/cinq/v1/quote answers, its title focused since it only informs;
 # the message is written once it is open, so its status region announces it.
 #
 # @param string id Id of the dialog.
 # @param object modal Texts: title, message ({total}, {email}), help, next_eyebrow, next_title, next_text,
 # button_label, note.
 #}

{%- embed 'components/modal.html.twig'
	with {
		id: id,
		title: modal.title | default( '' ),
		focus_title: true,
		modal: modal | default( {} ),
	} only
-%}
	{%- block content -%}
		<div class="flex flex-col gap-2">
			<p
				class="text-body text-base"
				role="status"
				data-dom="message"
				data-template="{{ modal.message | e( 'html_attr' ) }}"
			></p>
			{%- if modal.help -%}
				<p class="text-muted text-sm">{{- modal.help -}}</p>
			{%- endif -%}
		</div>

		<div class="border-default flex flex-col items-start gap-3 border-t pt-5">
			{{-
				include(
					'components/eyebrow.html.twig',
					{ title: modal.next_eyebrow },
					with_context: false
				)
			-}}
			{%- if modal.next_title -%}
				<h3 class="text-title-md">{{- modal.next_title -}}</h3>
			{%- endif -%}
			{%- if modal.next_text -%}
				<p class="text-body text-base">{{- modal.next_text -}}</p>
			{%- endif -%}
			{%- if modal.button_label -%}
				{{-
					include(
						'components/button.html.twig',
						{
							title: modal.button_label,
							url: '#',
							classes: [ 'w-full justify-center sm:w-auto' ],
							attributes: { 'data-dom': 'booking' },
						},
						with_context: false
					)
				-}}
			{%- endif -%}
			{%- if modal.note -%}
				<p class="text-muted text-sm">{{- modal.note -}}</p>
			{%- endif -%}
		</div>
	{%- endblock -%}
{%- endembed -%}
