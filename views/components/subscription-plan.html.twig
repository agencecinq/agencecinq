{#
 # Subscription plan: platform overline, range, description, monthly prices.
 # Takes the retainers of the catalogue, or retainers typed in the block with the same fields.
 # Schema.org: Service (name, description, serviceType) with nested Offers.
 #
 # @param string overline Platform label (e.g. Shopify).
 # @param string range The plan name.
 # @param string text The plan description.
 # @param array retainers Retainers: name, monthlyPriceExclVat, priceMode { id }.
 # @param string heading Heading tag for the title. Defaults to h3.
 #}

{%- set heading = heading | default( 'h3' ) -%}
{%- set retainers = retainers | default( [] ) -%}

{%- if overline or range or text or ( retainers | length ) -%}
	<article
		class="border-cream-soft rounded-8 flex w-full flex-col border bg-black p-8"
		itemscope
		itemtype="https://schema.org/Service"
		itemprop="item"
	>
		<div class="space-y-6">
			<div class="space-y-4">
				{%- if overline or range -%}
					<header class="space-y-3">
						{%- if overline -%}
							<p class="text-eyebrow text-stone" itemprop="serviceType">
								{{- overline -}}
							</p>
						{%- endif -%}

						{%- if range -%}
							<{{ heading }} class="text-title-lg text-cream" itemprop="name">
								{{- range -}}
							</{{ heading }}>
						{%- endif -%}
					</header>
				{%- endif -%}

				{%- if text -%}
					<p class="text-taupe text-sm" itemprop="description">
						{{- text | raw -}}
					</p>
				{%- endif -%}
			</div>

			{%- if retainers | length -%}
				<ul class="flex flex-wrap gap-x-6 gap-y-2">
					{%- for retainer in retainers -%}
						<li
							class="text-label text-pistachio"
							itemprop="offers"
							itemscope
							itemtype="https://schema.org/Offer"
						>
							<span itemprop="price">
								{{-
									[ retainer | retainer_tier, retainer | retainer_price ]
										| filter( part => part )
										| join( ' · ' )
								-}}
							</span>
						</li>
					{%- endfor -%}
				</ul>
			{%- endif -%}
		</div>
	</article>
{%- endif -%}
